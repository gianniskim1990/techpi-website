---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandStatement from '../components/home/BrandStatement.astro';
import Capabilities from '../components/home/Capabilities.astro';
import ContactSection from '../components/home/ContactSection.astro';
import Evolution from '../components/home/Evolution.astro';
import Hero from '../components/home/Hero.astro';
import Intelligence from '../components/home/Intelligence.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import { homeEn } from '../content/home.en';
import { getDictionary } from '../i18n';

const t = getDictionary('en');
---

<BaseLayout locale="en" page="home" title={t.pages.home.title} bleed>
  <Hero copy={homeEn.hero} locale="en" />
  <BrandStatement copy={homeEn.statement} />
  <SelectedWork copy={homeEn.work} locale="en" />
  <Capabilities copy={homeEn.capabilities} />
  <Intelligence copy={homeEn.intelligence} />
  <Evolution copy={homeEn.evolution} locale="en" />
  <ContactSection copy={homeEn.contact} locale="en" />
</BaseLayout>
