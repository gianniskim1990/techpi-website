---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCTA from '../components/secondary/ClosingCTA.astro';
import PageIntro from '../components/secondary/PageIntro.astro';
import SectionSplit from '../components/secondary/SectionSplit.astro';
import { capabilities } from '../content/capabilities';
import { caseStudiesFor } from '../content/projects';
import { pagesEn } from '../content/pages.en';
import { getDictionary } from '../i18n';
import { caseStudyPath, pathFor } from '../i18n/routes';

const t = getDictionary('en');
const copy = pagesEn.capabilities;
---

{/* The homepage capability index, opened up. No "How they combine" table (deferred). "Seen in" lists only
    published case studies that show the capability, so Intelligence has none for now. */}
<BaseLayout locale="en" page="capabilities" title={t.pages.capabilities.title} description={copy.lead} bleed>
  <PageIntro heading={copy.heading} lead={copy.lead} />
  <nav class="anchors" aria-label={copy.indexLabel}>
    {capabilities.map((c) => <a href={`#${c.id}`}>{c.name}</a>)}
  </nav>
  {
    capabilities.map((c) => (
      <SectionSplit id={c.id} heading={c.name}>
        <p class="summary">{c.summary}</p>
        <p class="covers">{copy.covers}</p>
        <ul class="ruled">
          {c.items.map((item) => <li>{item}</li>)}
        </ul>
        {caseStudiesFor(c.id).length > 0 && (
          <p class="seen">
            <span class="label">{copy.seenIn}</span>
            {caseStudiesFor(c.id).map((p, i) => (
              <>
                {i > 0 && ', '}
                <a class="tlink" href={caseStudyPath(p.slug)}>
                  {p.name}
                </a>
              </>
            ))}
          </p>
        )}
      </SectionSplit>
    ))
  }
  <ClosingCTA heading={pagesEn.closer.heading} cta={pagesEn.closer.cta} href={pathFor('contact', 'en')} />
</BaseLayout>

<style>
  .anchors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 64px var(--space-margin) 0;
    font-weight: var(--weight-ui);
  }
  .anchors a {
    display: inline-block;
    padding: 8px 0;
    text-underline-offset: 6px;
  }
  .summary {
    max-width: 36ch;
    font-size: var(--text-lead);
    line-height: 1.42;
  }
  .covers {
    margin-top: 40px;
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    color: var(--ter);
  }
  .ruled {
    margin-top: 10px;
  }
  .seen {
    margin-top: 28px;
    font-size: var(--text-small);
  }
  .label {
    margin-right: 12px;
    font-weight: var(--weight-ui);
    color: var(--ter);
  }
</style>
