---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCTA from '../components/secondary/ClosingCTA.astro';
import PageIntro from '../components/secondary/PageIntro.astro';
import ProjectRow from '../components/secondary/ProjectRow.astro';
import { pagesEn } from '../content/pages.en';
import { projects } from '../content/projects';
import { getDictionary } from '../i18n';
import { pathFor } from '../i18n/routes';

const t = getDictionary('en');
const copy = pagesEn.work;
---

<BaseLayout locale="en" page="work" title={t.pages.work.title} description={copy.lead} bleed>
  <PageIntro heading={t.pages.work.heading} lead={copy.lead} />
  {/* All projects as large rows. No count thresholds or filters: scaling is design guidance only for now. */}
  <section class="list s-ink" aria-label={t.pages.work.heading}>
    {projects.map((p, i) => <ProjectRow project={p} tone={(i % 3) + 1} capabilitiesLabel="Capabilities" />)}
  </section>
  <ClosingCTA heading={pagesEn.closer.heading} cta={pagesEn.closer.cta} href={pathFor('contact', 'en')} />
</BaseLayout>

<style>
  .list {
    margin-top: var(--space-section);
    padding: 40px var(--space-margin) 64px;
  }

  @media (max-width: 1023px) {
    .list {
      padding-left: 0;
      padding-right: 0;
      padding-top: 0;
    }
  }
</style>
