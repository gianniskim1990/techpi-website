---
import '../styles/fonts.css';
import commissionerGreek from '../assets/fonts/commissioner-greek.woff2?url';
import commissionerLatin from '../assets/fonts/commissioner-latin.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getDictionary } from '../i18n';
import { defaultLocale, locales, type Locale } from '../i18n/locales';
import { alternatesFor, pathFor, type PageKey } from '../i18n/routes';
import { ogLocale, socialImage } from '../content/seo';
import { breadcrumb, organization, serialise, webPage, website, type WebPageType } from '../seo/schema';

interface Props {
  locale: Locale;
  /** The route key. Omit on a 404, which has no canonical URL and no language alternates. */
  page?: PageKey;
  title: string;
  /** Written copy only. Omitted when there is none, never generated. */
  description?: string;
  kind?: 'page' | 'notfound';
  /**
   * Canonical paths in every language, for a page that is not in the route map (a case study). They drive the
   * canonical URL, reciprocal hreflang and the language switch. Pass `page` too, so the header marks the right section.
   */
  paths?: Record<Locale, string>;
  /** Full-bleed pages (the homepage) lay out their own sections. Shell pages get the padded container. */
  bleed?: boolean;
  /** Keeps this page out of search indexes even in a build that enables indexing. For unpublished route shells. */
  noindex?: boolean;
  /** The schema.org type of the page's WebPage node. */
  pageType?: WebPageType;
  /** A breadcrumb trail (paths, not URLs), only where it matches the real hierarchy of the site. */
  trail?: readonly { name: string; path: string }[];
  /** Further JSON-LD nodes the page describes (services). Built with src/seo/schema.ts. */
  schema?: readonly Record<string, unknown>[];
}

const {
  locale,
  page,
  title,
  description,
  kind = 'page',
  paths,
  bleed = false,
  noindex = false,
  pageType = 'WebPage',
  trail,
  schema = [],
} = Astro.props;
const t = getDictionary(locale);

// Canonical and hreflang URLs come from the route map, never from Astro.url
// (with build.format "preserve", Astro.url.pathname contains ".html" for normal pages).
const site = Astro.site;
if (!site) throw new Error('astro.config.mjs must set `site` so canonical URLs can be absolute.');
const absolute = (path: string) => new URL(path, site).href;

const hasRoute = kind === 'page' && page !== undefined;
const canonical = paths ? absolute(paths[locale]) : hasRoute ? absolute(pathFor(page, locale)) : undefined;
const alternates = paths
  ? [
      ...locales.map((l) => ({ hreflang: l, href: absolute(paths[l]) })),
      { hreflang: 'x-default', href: absolute(paths[defaultLocale]) },
    ]
  : hasRoute
    ? alternatesFor(page).map((a) => ({ hreflang: a.hreflang, href: absolute(a.path) }))
    : [];

// Safe default: nothing is indexable until launch. Only an explicit PUBLIC_ALLOW_INDEXING=true build is,
// a 404 is never indexable, and neither is a page flagged noindex (an unpublished route shell).
const indexable = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && kind === 'page' && !noindex;

// Sharing metadata and JSON-LD, for content pages only: a 404 has no URL of its own to share or describe.
// Everything is absolute on the production origin and static: no client script reads or writes any of it.
const ogImage = absolute(socialImage.path[locale]);
const ogAlternates = locales.filter((l) => l !== locale).map((l) => ogLocale[l]);
const jsonLd = canonical
  ? serialise([
      organization(),
      website(),
      webPage({
        type: pageType,
        url: canonical,
        name: title,
        description,
        locale,
        breadcrumb: Boolean(trail),
        aboutOrganization: page === 'home' || page === 'about',
      }),
      ...(trail ? [breadcrumb(canonical, trail.map((c) => ({ name: c.name, url: absolute(c.path) })))] : []),
      ...schema,
    ])
  : undefined;

// Preload only the font file for the script the page is mostly written in. Measured on a throttled connection
// (docs/production/identity-font-readiness.md): it brings that file in before or just after first paint, while
// preloading both files delays first paint and the file that matters. The other file loads normally.
const primaryFont = locale === 'el' ? commissionerGreek : commissionerLatin;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href={primaryFont} as="font" type="font/woff2" crossorigin />
    {/* From the approved app icon (scripts/brand/derive-identity.mjs). No web manifest: there is no app requirement. */}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* `js`: scripting runs (the mobile menu button replaces the footer link). `mo`: motion may run, so the hidden
        starting states of the reveal system apply. `sc`: scroll scenes run (desktop-sized windows only): the homepage
        sections hand over to each other with scroll-linked geometry (src/scripts/motion.ts). If the motion module has not confirmed itself (`mo-ready`)
        shortly after load, `mo` is removed again and every reveal simply shows: a failed script never hides text. */}
    <script is:inline>
      (function (d, w) {
        var c = d.documentElement.classList;
        c.add('js');
        if (w.matchMedia && w.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          c.add('mo');
          if (w.matchMedia('(min-width: 1024px) and (min-height: 700px)').matches) c.add('sc');
          w.setTimeout(function () {
            if (!c.contains('mo-ready')) c.remove('mo', 'sc');
          }, 3000);
        }
      })(document, window);
    </script>
    {/* Sharing metadata and JSON-LD last, after the font preload and the motion flags that affect first paint. */}
    {
      canonical && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="TechPi" />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={ogLocale[locale]} />
          {ogAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content={socialImage.type} />
          <meta property="og:image:width" content={String(socialImage.width)} />
          <meta property="og:image:height" content={String(socialImage.height)} />
          <meta property="og:image:alt" content={socialImage.alt[locale]} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          {description && <meta name="twitter:description" content={description} />}
          <meta name="twitter:image" content={ogImage} />
          <meta name="twitter:image:alt" content={socialImage.alt[locale]} />
          <script type="application/ld+json" set:html={jsonLd} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <Header locale={locale} page={hasRoute ? page : undefined} languageHrefs={paths} />
    <main id="main" tabindex="-1" class={bleed ? 'bleed' : undefined}>
      <slot />
    </main>
    <Footer locale={locale} page={hasRoute ? page : undefined} languageHrefs={paths} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  /* On short pages (a route shell) the footer stays at the bottom of the window instead of floating mid-page. */
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1 0 auto;
  }
</style>

<style>
  main {
    padding: calc(var(--space-section) + 40px) var(--space-margin) var(--space-section);
  }
  main.bleed {
    padding: 0;
  }
</style>
