---
import '../styles/tokens.css';
import '../styles/base.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TemporaryFonts from '../components/TemporaryFonts.astro';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/locales';
import { alternatesFor, pathFor, type PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  /** The route key. Omit on a 404, which has no canonical URL and no language alternates. */
  page?: PageKey;
  title: string;
  /** Written copy only. Omitted when there is none, never generated. */
  description?: string;
  kind?: 'page' | 'notfound';
  /**
   * Canonical path for a page that is not in the route map (a case study). Its language alternates are limited to
   * itself until the Greek version exists. Pass `page` too, so the header marks the right section.
   */
  path?: string;
  /** Full-bleed pages (the homepage) lay out their own sections. Shell pages get the padded container. */
  bleed?: boolean;
}

const { locale, page, title, description, kind = 'page', path, bleed = false } = Astro.props;
const t = getDictionary(locale);

// Canonical and hreflang URLs come from the route map, never from Astro.url
// (with build.format "preserve", Astro.url.pathname contains ".html" for normal pages).
const site = Astro.site;
if (!site) throw new Error('astro.config.mjs must set `site` so canonical URLs can be absolute.');
const absolute = (path: string) => new URL(path, site).href;

const hasRoute = kind === 'page' && page !== undefined;
const canonical = path ? absolute(path) : hasRoute ? absolute(pathFor(page, locale)) : undefined;
const alternates = path
  ? [{ hreflang: locale, href: absolute(path) }, { hreflang: 'x-default', href: absolute(path) }]
  : hasRoute
    ? alternatesFor(page).map((a) => ({ hreflang: a.hreflang, href: absolute(a.path) }))
    : [];

// Safe default: nothing is indexable until launch. Only an explicit PUBLIC_ALLOW_INDEXING=true build is,
// and a 404 is never indexable.
const indexable = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && kind === 'page';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {/* No favicon exists yet (the final identity comes later). An empty icon stops the browser requesting /favicon.ico. */}
    <link rel="icon" href="data:," />
    <TemporaryFonts />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <Header locale={locale} page={hasRoute ? page : undefined} />
    <main id="main" tabindex="-1" class={bleed ? 'bleed' : undefined}>
      <slot />
    </main>
    <Footer locale={locale} page={hasRoute ? page : undefined} />
  </body>
</html>

<style is:global>
  /* On short pages (a route shell) the footer stays at the bottom of the window instead of floating mid-page. */
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1 0 auto;
  }
</style>

<style>
  main {
    padding: calc(var(--space-section) + 40px) var(--space-margin) var(--space-section);
  }
  main.bleed {
    padding: 0;
  }
</style>
