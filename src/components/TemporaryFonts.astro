---
/**
 * TEMPORARY font loading. Delete this component, and its one use in BaseLayout, when the
 * self-hosted Commissioner files are supplied (docs/production/architecture.md, section 6).
 *
 * Why it exists: the approved typeface is Commissioner, and the self-hosted files have not been
 * prepared yet. Loading it from Google Fonts keeps the 400 / 450 / 500 hierarchy visible on previews.
 *
 * Why it must not ship: it sends every visitor's IP address to a third party before any consent.
 * The guard below fails the build if this component is still present in an indexable (production) build.
 */
if (import.meta.env.PUBLIC_ALLOW_INDEXING === 'true') {
  throw new Error(
    'TemporaryFonts is still in use in an indexable build. Replace it with self-hosted Commissioner before launch.',
  );
}
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{/* Variable weight axis limited to 400 to 600. The Latin and Greek subsets are delivered by unicode-range. */}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Commissioner:wght@400..600&display=swap"
/>
