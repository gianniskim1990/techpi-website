---
/**
 * Renders text so that hyphenated words ("EU-funded") never break at the hyphen. Commissioner has no non-breaking
 * hyphen glyph, so those words are wrapped in a no-wrap span instead. Other text passes through unchanged.
 */
interface Props {
  text: string;
}
const { text } = Astro.props;
const parts = text.split(/(\S*\w-\w\S*)/);
---

{parts.map((p, i) => (i % 2 === 1 ? <span style="white-space:nowrap">{p}</span> : p))}
