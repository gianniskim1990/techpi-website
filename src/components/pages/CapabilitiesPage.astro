---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/secondary/ClosingCTA.astro';
import PageIntro from '../../components/secondary/PageIntro.astro';
import SectionSplit from '../../components/secondary/SectionSplit.astro';
import { capabilitiesIn } from '../../content/capabilities';
import { caseStudiesWith } from '../../content/projects';
import { pagesCopy } from '../../content/copy';
import { pageMeta } from '../../content/seo';
import { service } from '../../seo/schema';
import type { Locale } from '../../i18n/locales';
import { caseStudyPath, pathFor } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pages = pagesCopy[locale];
const copy = pages.capabilities;
const capabilities = capabilitiesIn(locale);
const meta = pageMeta[locale].capabilities;
// One Service node per capability, with the name and summary shown on the page.
const url = new URL(pathFor('capabilities', locale), Astro.site).href;
const services = capabilities.map((c) => service(url, { id: c.id, name: c.name, description: c.summary, locale }));
---

{/* The homepage capability index, opened up. No "How they combine" table (deferred). "Seen in" lists only
    published case studies that show the capability, so Intelligence has none for now. */}
<BaseLayout locale={locale} page="capabilities" title={meta.title} description={meta.description} schema={services} bleed>
  <PageIntro heading={copy.heading} lead={copy.lead} />
  <nav class="anchors" aria-label={copy.indexLabel}>
    <ol>
      {
        capabilities.map((c) => (
          <li>
            <a href={`#${c.id}`}>
              <span class="name">{c.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  {
    capabilities.map((c) => (
      <SectionSplit id={c.id} heading={c.name}>
        <p class="summary">{c.summary}</p>
        <p class="covers">{copy.covers}</p>
        <ul class="ruled cover-list">
          {c.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {caseStudiesWith(c.id, locale).length > 0 && (
          <p class="seen">
            <span class="label">{copy.seenIn}</span>
            {caseStudiesWith(c.id, locale).map((p, i) => (
              <>
                {i > 0 && ', '}
                <a class="tlink" href={caseStudyPath(p.slug, locale)}>
                  {p.name}
                </a>
              </>
            ))}
          </p>
        )}
      </SectionSplit>
    ))
  }
  <ClosingCTA heading={pages.closer.heading} cta={pages.closer.cta} href={pathFor('contact', locale)} />
</BaseLayout>

<style>
  /* The four capabilities as an index under the page head: number and name, a hairline above each. */
  .anchors {
    margin: clamp(56px, 7vw, 104px) var(--space-margin) 0;
  }
  .anchors ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .anchors li {
    border-top: 1px solid var(--line);
  }
  .anchors a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 0 8px;
    text-decoration: none;
  }
  .anchors .num {
    color: var(--color-techpi-blue);
  }
  .anchors .name {
    font-size: var(--text-heading);
    line-height: 1.15;
    letter-spacing: -0.012em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color var(--duration-fast) var(--ease-state);
  }
  .anchors a:hover .name {
    text-decoration-color: currentColor;
  }
  .summary {
    max-width: 36ch;
    font-size: var(--text-lead);
    line-height: 1.42;
  }
  .covers {
    margin-top: 44px;
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    color: var(--ter);
  }
  .cover-list {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .cover-list li:nth-last-child(2):nth-child(odd) {
    border-bottom: 1px solid var(--line);
  }
  .seen {
    margin-top: 28px;
    font-size: var(--text-small);
  }
  .label {
    margin-right: 12px;
    font-weight: var(--weight-ui);
    color: var(--ter);
  }

  @media (max-width: 1023px) {
    .anchors ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 8px;
    }
  }
  @media (max-width: 760px) {
    .anchors ol {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
    .anchors li:last-child {
      border-bottom: 1px solid var(--line);
    }
    .anchors a {
      flex-direction: row;
      align-items: baseline;
      gap: 16px;
      padding: 12px 0;
    }
    .cover-list {
      display: block;
    }
    .cover-list li:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
  }
</style>
