---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import Crop from '../../components/Crop.astro';
import { compositions } from '../../components/workCompositions';
import FactRows from '../../components/secondary/FactRows.astro';
import SectionSplit from '../../components/secondary/SectionSplit.astro';
import { capabilityName } from '../../content/capabilities';
import { pagesCopy } from '../../content/copy';
import type { Locale } from '../../i18n/locales';
import { locales } from '../../i18n/locales';
import ClosingCTA from '../../components/secondary/ClosingCTA.astro';
import { nextCaseStudy, relatedCaseStudies, type Project, type ProjectImage } from '../../content/projects';
import { caseStudyPath, homePathFor, pathFor } from '../../i18n/routes';
import { getDictionary } from '../../i18n';
import { caseStudyMeta } from '../../content/seo';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const study = project.caseStudy;
if (!study) throw new Error(`${project.slug} has no case study.`);

const pages = pagesCopy[locale];
const copy = pages.caseStudy;
const next = nextCaseStudy(project.slug, locale);
const related = relatedCaseStudies(project.slug, locale);
const cover = study.cover;
const services = study.services ?? [];
const items = study.built.items ?? [];
const earlier = project.workGroup === 'earlier';
// The client is shown only where it adds something to the name above it.
const client = study.client && study.client !== project.name ? study.client : undefined;
const year = study.year ? String(study.year) : undefined;
const live = study.liveUrl;
// A strip with a single fact (the year) looks lopsided: it joins the category line instead.
const yearInline = Boolean(year) && !client && !live;
// Both languages exist for every published case study, so the canonical, hreflang and language switch pair them.
const paths = Object.fromEntries(locales.map((l) => [l, caseStudyPath(project.slug, l)])) as Record<Locale, string>;
const gallery: readonly ProjectImage[] = study.gallery ?? [];
const imageSizes = '(min-width: 1440px) 1312px, (min-width: 761px) 92vw, 100vw';

const hasTechnology = Boolean(study.technology && study.technology.length > 0);
const hasOutcome = Boolean(study.outcome && study.outcome.length > 0);
const comp = compositions[project.slug];
const t = getDictionary(locale);
const meta = caseStudyMeta(project, locale);
// Home, Work, this case study: the real hierarchy of the URL and of the page's own "Work" link. Visible labels only.
const trail = [
  { name: t.pages.home.heading, path: homePathFor(locale) },
  { name: t.nav.work, path: pathFor('work', locale) },
  { name: project.name, path: paths[locale] },
];
---

{/* The reusable case-study template: a product story, told editorially. Every block except the head, overview, need,
    what was built, next project and the closing invitation is optional: a block with no supported content is not
    rendered. A project with no published capture has no cover and no image section: its scope, set large on Ink,
    leads the page instead. No stand-in pictures, no metrics, no KPI blocks, no testimonials. */}
<BaseLayout
  locale={locale}
  page="work"
  paths={paths}
  title={meta.title}
  description={meta.description}
  trail={trail}
  bleed
>
  <section class="head s-paper">
    <a class="back" href={pathFor('work', locale)}><span aria-hidden="true">←</span> {copy.back}</a>
    <p class="meta-label cat">{project.category}{yearInline && ` · ${year}`}</p>
    {earlier && <p class="origin"><span>{copy.earlierTag}</span></p>}
    <h1 data-reveal="mask">{project.name}</h1>
    <p class="lead">{project.summary}</p>
    {earlier && <p class="attribution">{copy.earlier}</p>}
    {
      !yearInline && (
        <div class="strip">
          <FactRows
            variant="strip"
            rows={[
              { label: copy.client, value: client },
              { label: copy.year, value: year },
              {
                label: copy.live,
                value: live ? live.replace(/^https?:\/\//, '').replace(/\/$/, '') : undefined,
                href: live,
                hrefLabel: copy.liveAria,
              },
            ]}
          />
        </div>
      )
    }
  </section>

  {/* The cover: the product at a scale where its interface reads, cropped to a band and run edge to edge. The
      whole capture follows later, after what was built. */}
  {
    cover ? (
      <figure class="cover s-ink">
        {comp?.cover ? (
          <Crop image={cover} crop={comp.cover} small={comp.thumb} vw={[100, 100]} loading="eager" />
        ) : (
          <ProjectMedia image={cover} sizes={imageSizes} loading="eager" class="shot" />
        )}
        {cover.caption && <figcaption>{cover.caption}</figcaption>}
      </figure>
    ) : (
      services.length > 0 && (
        /* No published capture: the scope of the work, set as display type on the same Ink band a cover would take. */
        <section class="scope s-ink" aria-labelledby="scope-h">
          <h2 id="scope-h" class="meta-label">{copy.services}</h2>
          <ol class="scope-list">
            {services.map((service, i) => (
              <li style={`--n:${i}`}>{service}</li>
            ))}
          </ol>
        </section>
      )
    )
  }

  <SectionSplit id="overview" heading={copy.overview} size="s">
    {study.overview.map((p, i) => <p class={i === 0 ? 'lead-text' : 'read'}>{p}</p>)}
  </SectionSplit>

  <SectionSplit id="need" heading={earlier ? copy.context : copy.need} size="s">
    {study.need.map((p) => <p class="read">{p}</p>)}
  </SectionSplit>

  {/* "What we built" when the work is itemised; "The solution" when the source describes it in one statement. */}
  <SectionSplit id="built" heading={items.length > 0 ? copy.built : copy.solution} size="s">
    {study.built.intro && <p class="lead-text">{study.built.intro}</p>}
    {
      items.length > 0 && (
        <ol class="items">
          {items.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      )
    }
    {
      cover && services.length > 0 && (
        <p class="capline">
          <span class="label">{copy.services}</span>
          {services.join(', ')}
        </p>
      )
    }
    {
      project.capabilities.length > 0 && (
        <p class="capline">
          <span class="label">{copy.capabilities}</span>
          {project.capabilities.map((id, i) => (
            <>
              {i > 0 && ', '}
              <a class="tlink" href={`${pathFor('capabilities', locale)}#${id}`}>
                {capabilityName(id, locale)}
              </a>
            </>
          ))}
        </p>
      )
    }
  </SectionSplit>

  {/* The whole picture: the full capture, and beside it the project's other real screens at a smaller scale. */}
  {
    cover && (
      <section class="whole s-ink horizon" aria-label={project.name} data-scene>
        <figure class="whole-main">
          <ProjectMedia image={cover} sizes="(min-width: 1024px) 64vw, 100vw" class="shot" />
        </figure>
        {gallery.map((image) => (
          <figure class="whole-side">
            <ProjectMedia image={image} sizes="(min-width: 1024px) 30vw, 100vw" class="shot" />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )
  }

  {
    hasTechnology && (
      <SectionSplit id="technology" heading={copy.technology} size="s">
        <ul class="ruled tech">
          {study.technology?.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </SectionSplit>
    )
  }

  {
    hasOutcome && (
      <SectionSplit id="outcome" heading={copy.outcome} size="s">
        <ul class="ruled outcome">
          {study.outcome?.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </SectionSplit>
    )
  }

  {/* Other case studies from the same Work group, as a short catalogue: the name and what it is. */}
  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h" class="meta-label">{copy.related}</h2>
        <ul class="related-list">
          {related.map((p) => (
            <li>
              <a href={caseStudyPath(p.slug, locale)}>
                <span class="related-name">{p.name}</span>
                <span class="related-cat">{p.category}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* No aria-label: the link is named by its own visible text, so the accessible name always contains what is shown (WCAG 2.5.3). */}
  <a class="next s-ink" href={caseStudyPath(next.slug, locale)}>
    <span class="next-txt">
      <span class="meta-label">{copy.next}</span>
      <span class="next-name">{next.name}</span>
      <span class="next-cat">{next.category}</span>
      <span class="tlink">{copy.next}</span>
    </span>
    {
      next.image && (
        <span class="next-media" aria-hidden="true">
          <Crop image={next.image} alt="" crop={compositions[next.slug]?.thumb} vw={[36, 100]} />
        </span>
      )
    }
  </a>

  <ClosingCTA heading={pages.closer.heading} cta={pages.closer.cta} href={pathFor('contact', locale)} />
</BaseLayout>

<style>
  /* ---------- Head ---------- */
  .head {
    padding: clamp(136px, 13vw, 184px) var(--space-margin) clamp(56px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .back {
    grid-column: 1 / -1;
    justify-self: start;
    margin-bottom: clamp(40px, 5vw, 72px);
    padding: 8px 0;
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .cat {
    grid-column: 1 / -1;
  }
  h1 {
    grid-column: 1 / span 10;
    margin-top: 18px;
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.034em;
  }
  .lead {
    grid-column: 1 / span 6;
    margin-top: clamp(28px, 3vw, 44px);
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--sec-c);
  }
  /* Earlier work: a quiet provenance tag above the title and one plain sentence under the lead. Ink-toned, not a banner. */
  .origin {
    grid-column: 1 / -1;
    margin-top: 14px;
  }
  .origin span {
    display: inline-block;
    padding: 5px 12px;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    line-height: 1.3;
  }
  .origin + h1 {
    margin-top: 22px;
  }
  .attribution {
    grid-column: 1 / span 6;
    margin-top: 24px;
    max-width: 52ch;
    font-size: var(--text-small);
    color: var(--sec-c);
  }
  .strip {
    grid-column: 1 / -1;
    margin-top: clamp(48px, 6vw, 88px);
  }

  /* ---------- Scope, in place of a cover, on Ink ---------- */
  .scope {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: start;
    padding: clamp(56px, 6vw, 96px) var(--space-margin) clamp(64px, 7vw, 112px);
  }
  .scope h2 {
    grid-column: 1 / span 3;
    padding-top: 0.9em;
    color: var(--ter);
  }
  .scope-list {
    grid-column: 4 / -1;
    counter-reset: scope;
  }
  .scope-list li {
    counter-increment: scope;
    display: flex;
    align-items: baseline;
    gap: clamp(16px, 2vw, 32px);
    padding: clamp(14px, 1.4vw, 22px) 0;
    border-top: 1px solid var(--line);
    font-size: clamp(1.625rem, 3.6vw, 3.25rem);
    font-weight: var(--weight-display);
    line-height: 1.05;
    letter-spacing: -0.024em;
  }
  .scope-list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .scope-list li::before {
    content: counter(scope, decimal-leading-zero);
    flex: none;
    min-width: 2.2em;
    font-size: var(--text-label);
    font-weight: var(--weight-ui);
    letter-spacing: 0.02em;
    color: var(--ter);
    font-variant-numeric: tabular-nums;
  }
  /* The lines rise in from the left on first paint, after the heading, as a cover would be uncovered. */
  :global(.mo) .scope-list li {
    animation: scope-in 900ms var(--ease-reveal) calc(300ms + var(--n, 0) * 70ms) both;
  }
  @keyframes scope-in {
    from {
      opacity: 0;
      translate: -24px 0;
    }
  }

  /* ---------- The cover band and the whole picture, on Ink ---------- */
  .cover {
    margin: 0;
  }
  .cover:has(figcaption) {
    padding-bottom: 14px;
  }
  .cover figcaption,
  .whole figcaption {
    margin-top: 12px;
    font-size: var(--text-label);
    color: var(--ter);
  }
  .cover figcaption {
    padding: 0 var(--space-margin);
  }
  .cover > :global(.pm) {
    margin: 0 auto;
    --maxh: min(80vh, 760px);
  }
  .whole {
    margin-top: var(--space-section);
    padding: clamp(56px, 6vw, 96px) var(--space-margin);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    row-gap: 40px;
    align-items: end;
  }
  .whole figure {
    margin: 0;
  }
  .whole-main {
    grid-column: 1 / span 8;
  }
  .whole-main :global(.pm) {
    --maxh: 72vh;
  }
  .whole-side {
    grid-column: 9 / span 4;
  }
  .whole-side + .whole-side {
    grid-column: 9 / span 4;
  }

  /* ---------- Story text ---------- */
  .lead-text {
    max-width: 34ch;
    font-size: clamp(1.375rem, 2.2vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .read {
    max-width: 62ch;
    color: var(--sec-c);
  }
  .read + .read,
  .lead-text + .read {
    margin-top: 18px;
  }
  .items {
    margin-top: 8px;
  }
  .lead-text + .items {
    margin-top: 32px;
  }
  .items li {
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .items li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .capline {
    margin-top: 32px;
    font-size: var(--text-small);
  }
  .label {
    margin-right: 12px;
    font-weight: var(--weight-ui);
    color: var(--ter);
  }
  .tech {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .tech li:nth-last-child(2):nth-child(odd) {
    border-bottom: 1px solid var(--line);
  }
  .outcome li {
    font-size: var(--text-lead);
    line-height: 1.38;
    padding: 18px 0;
  }

  /* ---------- Related projects ---------- */
  .related {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    margin-top: var(--space-section);
    padding: 0 var(--space-margin);
  }
  .related h2 {
    grid-column: 1 / span 3;
    padding-top: 22px;
    color: var(--ter);
  }
  .related-list {
    grid-column: 4 / -1;
  }
  .related-list li {
    border-top: 1px solid var(--line);
  }
  .related-list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .related-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--space-gap);
    align-items: baseline;
    padding: 20px 0;
    text-decoration: none;
  }
  .related-name {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: var(--weight-display);
    line-height: 1.1;
    letter-spacing: -0.016em;
    transition: color var(--duration-fast) var(--ease-state);
  }
  .related-cat {
    font-size: var(--text-small);
    color: var(--ter);
  }
  .related-list a:hover .related-name,
  .related-list a:focus-visible .related-name {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  /* ---------- Next project ---------- */
  .next {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: end;
    margin-top: var(--space-section);
    padding: clamp(56px, 6vw, 88px) var(--space-margin) clamp(80px, 9vw, 136px);
    text-decoration: none;
  }
  /* The closing invitation follows directly, Blue against Ink, with no Paper gap between them. */
  .next + :global(.closer) {
    margin-top: 0;
  }
  .next-txt {
    grid-column: 1 / span 6;
  }
  .next-name {
    display: block;
    margin: 18px 0 12px;
    font-size: var(--text-display-l);
    font-weight: var(--weight-display);
    line-height: 1.02;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .next-cat {
    display: block;
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--sec-c);
  }
  .next .tlink {
    display: inline-block;
    margin-top: 36px;
  }
  .next:hover .tlink {
    color: var(--link);
    text-underline-offset: 8px;
  }
  .next-media {
    grid-column: 9 / span 4;
    display: block;
  }
  .next-name {
    transition: color var(--duration-fast) var(--ease-state);
  }
  .next-media :global(img) {
    transition: scale 1100ms var(--ease-reveal);
  }
  @media (hover: hover) {
    .next:hover .next-name {
      color: var(--color-cyan);
    }
    .next:hover .next-media :global(img) {
      scale: 1.06;
    }
  }
  /* The cover is uncovered from the left on first paint, after the heading. */
  :global(.mo) .cover > :global(.crop),
  :global(.mo) .cover > :global(.pm) {
    animation: cover-in 1300ms var(--ease-reveal) 350ms both;
  }
  @keyframes cover-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 1023px) {
    .head {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    h1,
    .lead {
      grid-column: 1 / -1;
    }
    .lead {
      max-width: 40ch;
    }
    .next {
      display: block;
    }
    .next-media {
      margin-top: 48px;
      max-width: 420px;
    }
    .whole {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .whole-main {
      grid-column: 1 / -1;
    }
    .whole-side {
      grid-column: 1 / span 5;
    }
    .scope,
    .related {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .scope h2,
    .related h2 {
      grid-column: 1 / -1;
      padding-top: 0;
      margin-bottom: 20px;
    }
    .scope-list,
    .related-list {
      grid-column: 1 / -1;
    }
    .attribution {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .head {
      display: block;
      padding-top: 112px;
    }
    .back {
      display: inline-block;
      margin-bottom: 36px;
    }
    h1 {
      margin-top: 14px;
    }
    .whole {
      display: block;
      padding: 0 0 40px;
    }
    .whole-side {
      margin: 24px var(--space-margin) 0;
    }
    .whole-main :global(.pm) {
      width: 100%;
    }
    .tech {
      display: block;
    }
    .tech li:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
    .scope,
    .related {
      display: block;
    }
    .related-list a {
      display: block;
    }
    .related-cat {
      display: block;
      margin-top: 6px;
    }

  }
</style>
