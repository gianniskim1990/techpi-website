---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import FactRows from '../../components/secondary/FactRows.astro';
import SectionSplit from '../../components/secondary/SectionSplit.astro';
import { capabilityName } from '../../content/capabilities';
import { pagesCopy } from '../../content/copy';
import type { Locale } from '../../i18n/locales';
import { locales } from '../../i18n/locales';
import { nextCaseStudy, type Project, type ProjectImage } from '../../content/projects';
import { caseStudyPath, pathFor } from '../../i18n/routes';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const study = project.caseStudy;
if (!study) throw new Error(`${project.slug} has no case study.`);

const copy = pagesCopy[locale].caseStudy;
const next = nextCaseStudy(project.slug, locale);
// Both languages exist for every published case study, so the canonical, hreflang and language switch pair them.
const paths = Object.fromEntries(locales.map((l) => [l, caseStudyPath(project.slug, l)])) as Record<Locale, string>;
const gallery: readonly ProjectImage[] = study.gallery ?? [];
const imageSizes = '(min-width: 1440px) 1312px, (min-width: 761px) 92vw, 100vw';

// The story's sections are numbered in reading order. Optional sections that are absent take no number.
const hasTechnology = Boolean(study.technology && study.technology.length > 0);
const hasOutcome = Boolean(study.outcome && study.outcome.length > 0);
const order = ['overview', 'need', 'built', ...(hasTechnology ? ['technology'] : []), ...(hasOutcome ? ['outcome'] : [])];
const indexOf = (id: string) => String(order.indexOf(id) + 1).padStart(2, '0');
---

{/* The reusable case-study template: a product story, told editorially. Every block except the head, cover,
    overview, need, what we built and next project is optional: a block with no supported content is not rendered.
    No metrics, no KPI blocks, no testimonials. */}
<BaseLayout
  locale={locale}
  page="work"
  paths={paths}
  title={`${project.name} | TechPi`}
  description={project.summary}
  bleed
>
  <section class="head s-paper">
    <a class="back" href={pathFor('work', locale)}><span aria-hidden="true">←</span> {copy.back}</a>
    <p class="meta-label cat">{project.category}</p>
    <h1 data-reveal="mask">{project.name}</h1>
    <p class="lead" data-reveal="fade" style="--delay:120ms">{project.summary}</p>
    <div class="strip" data-reveal="fade" style="--delay:200ms">
      <FactRows
        variant="strip"
        rows={[
          { label: copy.client, value: study.client },
          { label: copy.year, value: study.year ? String(study.year) : undefined },
          {
            label: copy.live,
            value: study.liveUrl ? study.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') : undefined,
            href: study.liveUrl,
            hrefLabel: copy.liveAria,
          },
        ]}
      />
    </div>
  </section>

  <figure class="band s-ink cover">
    <ProjectMedia image={study.cover} sizes={imageSizes} loading="eager" class="shot" />
    {study.cover.caption && <figcaption>{study.cover.caption}</figcaption>}
  </figure>

  <SectionSplit id="overview" heading={copy.overview} index={indexOf('overview')}>
    {study.overview.map((p, i) => <p class={i === 0 ? 'lead-text' : 'read'}>{p}</p>)}
  </SectionSplit>

  <SectionSplit id="need" heading={copy.need} index={indexOf('need')}>
    {study.need.map((p) => <p class="read">{p}</p>)}
  </SectionSplit>

  <SectionSplit id="built" heading={copy.built} index={indexOf('built')}>
    {study.built.intro && <p class="lead-text">{study.built.intro}</p>}
    <ol class="items">
      {
        study.built.items.map((item, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ol>
    <p class="capline">
      <span class="label">{copy.capabilities}</span>
      {
        project.capabilities.map((id, i) => (
          <>
            {i > 0 && ', '}
            <a class="tlink" href={`${pathFor('capabilities', locale)}#${id}`}>
              {capabilityName(id, locale)}
            </a>
          </>
        ))
      }
    </p>
  </SectionSplit>

  {
    gallery.length > 0 && (
      <section class="band s-ink gallery" aria-label={project.name}>
        {gallery.map((image) => (
          <figure>
            <ProjectMedia image={image} sizes={imageSizes} reveal class="shot" />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )
  }

  {
    hasTechnology && (
      <SectionSplit id="technology" heading={copy.technology} index={indexOf('technology')}>
        <ul class="ruled tech">
          {study.technology?.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </SectionSplit>
    )
  }

  {
    hasOutcome && (
      <SectionSplit id="outcome" heading={copy.outcome} index={indexOf('outcome')}>
        <ul class="ruled outcome">
          {study.outcome?.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </SectionSplit>
    )
  }

  {/* The curved Ink edge hands over to the next project. Desktop only, decorative. */}
  <div class="edge" aria-hidden="true"><div></div></div>
  <a class="next s-ink" href={caseStudyPath(next.slug, locale)} aria-label={`${copy.next}: ${next.name}`}>
    <span class="next-txt">
      <span class="meta-label">{copy.next}</span>
      <span class="next-name">{next.name}</span>
      <span class="next-cat">{next.category}</span>
      <span class="tlink">{copy.next}<span class="arr" aria-hidden="true">→</span></span>
    </span>
    {
      next.image && (
        <span class="next-media" aria-hidden="true">
          <ProjectMedia image={next.image} alt="" sizes="(min-width: 1024px) 36vw, 100vw" widths={[480, 720, 960]}>
            <span class="badge">
              <span>→</span>
            </span>
          </ProjectMedia>
        </span>
      )
    }
  </a>
</BaseLayout>

<style>
  /* ---------- Head ---------- */
  .head {
    padding: clamp(136px, 13vw, 184px) var(--space-margin) clamp(56px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .back {
    grid-column: 1 / -1;
    justify-self: start;
    margin-bottom: clamp(40px, 5vw, 72px);
    padding: 8px 0;
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .cat {
    grid-column: 1 / -1;
  }
  h1 {
    grid-column: 1 / span 10;
    margin-top: 18px;
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.034em;
  }
  .lead {
    grid-column: 1 / span 6;
    margin-top: clamp(28px, 3vw, 44px);
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--sec-c);
  }
  .strip {
    grid-column: 1 / -1;
    margin-top: clamp(48px, 6vw, 88px);
  }

  /* ---------- Media bands on Ink. Captures keep their proportions and are never cropped here. ---------- */
  .band {
    margin: 0;
    padding: clamp(40px, 5vw, 80px) var(--space-margin);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .band figure {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .band :global(.shot) {
    --maxh: min(82vh, 820px);
  }
  .band figcaption {
    margin-top: 16px;
    align-self: flex-start;
    font-size: var(--text-small);
    color: var(--ter);
  }
  .gallery {
    margin-top: var(--space-section);
    gap: clamp(40px, 5vw, 72px);
  }

  /* ---------- Story text ---------- */
  .lead-text {
    max-width: 40ch;
    font-size: var(--text-lead);
    line-height: 1.42;
  }
  .read {
    max-width: 62ch;
    color: var(--sec-c);
  }
  .read + .read,
  .lead-text + .read {
    margin-top: 18px;
  }
  .items {
    margin-top: 8px;
  }
  .lead-text + .items {
    margin-top: 32px;
  }
  .items li {
    display: grid;
    grid-template-columns: 3.2em minmax(0, 1fr);
    gap: 8px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .items li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .items .num {
    padding-top: 0.2em;
  }
  .capline {
    margin-top: 32px;
    font-size: var(--text-small);
  }
  .label {
    margin-right: 12px;
    font-weight: var(--weight-ui);
    color: var(--ter);
  }
  .tech {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .tech li:nth-last-child(2):nth-child(odd) {
    border-bottom: 1px solid var(--line);
  }
  .outcome li {
    font-size: var(--text-lead);
    line-height: 1.38;
    padding: 18px 0;
  }

  /* ---------- Next project ---------- */
  .edge {
    display: none;
  }
  .next {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: end;
    margin-top: var(--space-section);
    padding: clamp(56px, 6vw, 88px) var(--space-margin) clamp(80px, 9vw, 136px);
    text-decoration: none;
  }
  /* Separates the next project from the Ink footer that follows. */
  .next::after {
    content: '';
    position: absolute;
    left: var(--space-margin);
    right: var(--space-margin);
    bottom: 0;
    height: 1px;
    background: var(--line);
  }
  .next-txt {
    grid-column: 1 / span 6;
  }
  .next-name {
    display: block;
    margin: 18px 0 12px;
    font-size: var(--text-display-l);
    font-weight: var(--weight-display);
    line-height: 1.02;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .next-cat {
    display: block;
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--sec-c);
  }
  .next .tlink {
    display: inline-block;
    margin-top: 36px;
  }
  .next:hover .tlink {
    color: var(--link);
    text-underline-offset: 8px;
  }
  .next-media {
    grid-column: 8 / span 5;
    display: block;
    --maxh: 360px;
  }
  .next-media :global(.pm) {
    margin-left: auto;
  }
  .next-media :global(img) {
    transition: transform 900ms var(--ease-reveal);
  }
  @media (hover: hover) {
    .next:hover .next-media :global(img) {
      transform: scale(1.035);
    }
    .next:hover :global(.badge) {
      opacity: 1;
      transform: none;
    }
    .next:hover :global(.badge > span) {
      transform: none;
    }
    .next:hover .next-name {
      translate: 10px 0;
    }
  }
  .next-name {
    transition: translate 600ms var(--ease-reveal);
  }

  @media (min-width: 1024px) {
    .edge {
      display: block;
      position: relative;
      height: 16vw;
      overflow: hidden;
      margin-top: var(--space-section);
      margin-bottom: -1px;
      background: var(--color-paper);
    }
    .edge > div {
      position: absolute;
      width: 583.4vw;
      height: 583.4vw;
      border-radius: 50%;
      left: calc(100% - 293vw);
      top: 0.7vw;
      background: var(--color-ink);
    }
    .edge + .next {
      margin-top: 0;
    }
  }

  @media (max-width: 1023px) {
    .head {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    h1,
    .lead {
      grid-column: 1 / -1;
    }
    .lead {
      max-width: 40ch;
    }
    .next {
      display: block;
    }
    .next-media {
      margin-top: 48px;
      --maxh: 300px;
    }
    .next-media :global(.pm) {
      margin-left: 0;
    }
  }

  @media (max-width: 760px) {
    .head {
      display: block;
      padding-top: 112px;
    }
    .back {
      display: inline-block;
      margin-bottom: 36px;
    }
    h1 {
      margin-top: 14px;
    }
    .band {
      padding: 0;
    }
    .band :global(.shot) {
      width: 100%;
    }
    .band figcaption {
      padding: 0 var(--space-margin) 20px;
    }
    .gallery {
      gap: 2px;
    }
    .tech {
      display: block;
    }
    .tech li:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
    .items li {
      grid-template-columns: 2.6em minmax(0, 1fr);
    }
    .next-media {
      --maxh: 240px;
    }
  }
</style>
