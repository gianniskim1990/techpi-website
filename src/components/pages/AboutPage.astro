---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/secondary/ClosingCTA.astro';
import PageIntro from '../../components/secondary/PageIntro.astro';
import SectionSplit from '../../components/secondary/SectionSplit.astro';
import { pagesCopy } from '../../content/copy';
import { getDictionary } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const pages = pagesCopy[locale];
const copy = pages.about;
---

{/* Concise and forward-looking. Evolution statement, what stayed and what changed, and four principles.
    No founder story, timeline, team, years, client counts, countries or statistics: none is confirmed.
    The one hairline arc of the secondary pages lives here, desktop only. */}
<BaseLayout locale={locale} page="about" title={t.pages.about.title} description={copy.lead} bleed>
  <PageIntro heading={copy.heading} lead={copy.lead} roomBelow>
    <div class="arc" aria-hidden="true"></div>
  </PageIntro>

  <SectionSplit id="evolution" heading={copy.changeHeading}>
    <ul class="pair">
      <li>
        <p class="step">{copy.stayed.label}</p>
        <p class="text">{copy.stayed.text}</p>
      </li>
      <li>
        <p class="step">{copy.changed.label}</p>
        <p class="text">{copy.changed.text}</p>
      </li>
    </ul>
    <p class="name">{copy.name}</p>
  </SectionSplit>

  <SectionSplit id="principles" heading={copy.principlesHeading}>
    <ol class="principles">
      {
        copy.principles.map((p) => (
          <li>
            <h3>{p.heading}</h3>
            {p.text && <p>{p.text}</p>}
          </li>
        ))
      }
    </ol>
  </SectionSplit>

  <ClosingCTA heading={pages.closer.heading} cta={pages.closer.cta} href={pathFor('contact', locale)} />
</BaseLayout>

<style>
  /* The same 1.25px Ink hairline as the homepage hero arc. It enters from the right edge below the header and
     leaves through the bottom of the page head, to the right of the lead, so it never crosses the header or the
     text. Wide desktop only (the 12-column grid, 1280px and up): below that there is no position clear of the header, the h1 and the lead. */
  .arc {
    display: none;
  }
  @media (min-width: 1280px) {
    .arc {
      display: block;
      position: absolute;
      width: 3600px;
      height: 3600px;
      left: calc(100% - 800px);
      bottom: -3000px;
      border: 1.25px solid var(--color-ink);
      border-radius: 50%;
      pointer-events: none;
    }
  }

  /* The Greek lead is longer: it wraps earlier so the arc still passes clear of it. */
  :global(.intro:has(.arc) .lead:lang(el)) {
    max-width: 22ch;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap);
  }
  .pair li {
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .step {
    font-size: 0.875rem;
    font-weight: var(--weight-ui);
    color: var(--ter);
  }
  .text {
    margin-top: 28px;
    color: var(--sec-c);
    max-width: 38ch;
  }
  .name {
    margin-top: 40px;
    max-width: 640px;
    font-size: var(--text-lead);
    line-height: 1.42;
  }

  .principles li {
    padding: 26px 0 30px;
    border-top: 1px solid var(--line);
  }
  .principles li:last-child {
    border-bottom: 1px solid var(--line);
  }
  h3 {
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.012em;
  }
  .principles p {
    margin-top: 10px;
    color: var(--sec-c);
    max-width: 52ch;
  }

  @media (max-width: 760px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .text {
      margin-top: 18px;
    }
  }
</style>
