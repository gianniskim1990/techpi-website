---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/secondary/ClosingCTA.astro';
import PageIntro from '../../components/secondary/PageIntro.astro';
import SectionSplit from '../../components/secondary/SectionSplit.astro';
import { pagesCopy } from '../../content/copy';
import { pageMeta } from '../../content/seo';
import type { Locale } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pages = pagesCopy[locale];
const copy = pages.about;
const meta = pageMeta[locale].about;
---

{/* Concise and forward-looking. Evolution statement, what stayed and what changed, and four principles.
    No founder story, timeline, team, years, client counts, countries or statistics: none is confirmed.
    The hairline arc that sat in the page head was removed in the final design pass: the arc now belongs to the
    homepage sequence only, where it resolves into the symbol. */}
<BaseLayout locale={locale} page="about" title={meta.title} description={meta.description} pageType="AboutPage" bleed>
  <PageIntro heading={copy.heading} lead={copy.lead} />

  <SectionSplit id="evolution" heading={copy.changeHeading}>
    <ul class="pair">
      <li class="rule">
        <p class="step">{copy.stayed.label}</p>
        <p class="text">{copy.stayed.text}</p>
      </li>
      <li class="rule">
        <p class="step">{copy.changed.label}</p>
        <p class="text">{copy.changed.text}</p>
      </li>
    </ul>
    <p class="name">{copy.name}</p>
  </SectionSplit>

  <SectionSplit id="principles" heading={copy.principlesHeading}>
    <ol class="principles">
      {
        copy.principles.map((p) => (
          <li>
            <h3>{p.heading}</h3>
            {p.text && <p>{p.text}</p>}
          </li>
        ))
      }
    </ol>
  </SectionSplit>

  <ClosingCTA heading={pages.closer.heading} cta={pages.closer.cta} href={pathFor('contact', locale)} />
</BaseLayout>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap);
  }
  .pair li {
    padding-top: 18px;
  }
  .step {
    font-size: 0.875rem;
    font-weight: var(--weight-ui);
    color: var(--ter);
  }
  .text {
    margin-top: 28px;
    color: var(--sec-c);
    max-width: 38ch;
  }
  .name {
    margin-top: 40px;
    max-width: 640px;
    font-size: var(--text-lead);
    line-height: 1.42;
  }

  .principles li {
    padding: 26px 0 32px;
    border-top: 1px solid var(--line);
  }
  .principles li:last-child {
    border-bottom: 1px solid var(--line);
  }
  h3 {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.018em;
  }
  .principles p {
    margin-top: 8px;
    color: var(--sec-c);
    max-width: 52ch;
  }

  @media (max-width: 760px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .text {
      margin-top: 18px;
    }
  }
</style>
