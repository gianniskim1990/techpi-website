---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/secondary/ClosingCTA.astro';
import PageIntro from '../../components/secondary/PageIntro.astro';
import ProjectRow from '../../components/secondary/ProjectRow.astro';
import { pagesCopy } from '../../content/copy';
import { projectsIn } from '../../content/projects';
import { getDictionary } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const pages = pagesCopy[locale];
const copy = pages.work;
---

<BaseLayout locale={locale} page="work" title={t.pages.work.title} description={copy.lead} bleed>
  <PageIntro heading={t.pages.work.heading} lead={copy.lead} />
  {/* All projects as large rows. No count thresholds or filters: scaling is design guidance only for now. */}
  <section class="list s-ink" aria-label={t.pages.work.heading}>
    {projectsIn(locale).map((p, i) => <ProjectRow
        project={p}
        locale={locale}
        tone={(i % 3) + 1}
        capabilitiesLabel={pages.capabilities.indexLabel}
        linkLabel={copy.linkLabel}
      />)}
  </section>
  <ClosingCTA heading={pages.closer.heading} cta={pages.closer.cta} href={pathFor('contact', locale)} />
</BaseLayout>

<style>
  .list {
    margin-top: var(--space-section);
    padding: 40px var(--space-margin) 64px;
  }

  @media (max-width: 1023px) {
    .list {
      padding-left: 0;
      padding-right: 0;
      padding-top: 0;
    }
  }
</style>
