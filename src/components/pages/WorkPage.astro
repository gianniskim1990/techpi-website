---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/secondary/ClosingCTA.astro';
import PageIntro from '../../components/secondary/PageIntro.astro';
import ProjectRow from '../../components/secondary/ProjectRow.astro';
import { pagesCopy } from '../../content/copy';
import { projectsIn, workGroups } from '../../content/projects';
import { pageMeta } from '../../content/seo';
import { getDictionary } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { pathFor } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const pages = pagesCopy[locale];
const copy = pages.work;
const meta = pageMeta[locale].work;
const projectList = projectsIn(locale);
const grouped = workGroups.map((id) => ({
  id,
  ...copy.groups[id],
  projects: projectList.filter((project) => project.workGroup === id),
}));
---

<BaseLayout locale={locale} page="work" title={meta.title} description={meta.description} pageType="CollectionPage" bleed>
  <PageIntro heading={t.pages.work.heading} lead={copy.lead} variant="word" />
  {/* Work stays a single catalogue, now with truthful distinctions between commissions, adaptable
      solutions, and TechPi's own products. Only projects with published case studies link to one. */}
  <div class="groups s-paper">
    {
      grouped.map((group) => (
        <section class="group" aria-labelledby={`work-${group.id}`}>
          <div class="group-head" data-reveal="fade">
            <h2 id={`work-${group.id}`}>{group.heading}</h2>
            <p>{group.description}</p>
          </div>
          <div class="list">
            {group.projects.map((project) => (
              <ProjectRow
                project={project}
                locale={locale}
                capabilitiesLabel={pages.capabilities.indexLabel}
                linkLabel={copy.linkLabel}
                solutionLinkLabel={copy.solutionLink}
                highlightsLabel={copy.highlightsLabel}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>
  <ClosingCTA heading={pages.closer.heading} cta={pages.closer.cta} href={pathFor('contact', locale)} />
</BaseLayout>

<style>
  .groups {
    margin: clamp(64px, 7vw, 112px) var(--space-margin) 0;
  }
  .group + .group {
    margin-top: clamp(80px, 9vw, 144px);
  }
  .group-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: start;
    padding-bottom: clamp(24px, 3vw, 44px);
  }
  .group-head h2 {
    grid-column: 1 / span 7;
    font-size: var(--text-display-m);
    line-height: 1.06;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .group-head p {
    grid-column: 8 / span 5;
    max-width: 45ch;
    color: var(--sec-c);
    font-size: var(--text-lead);
    line-height: 1.42;
  }
  .list {
    border-bottom: 1px solid var(--color-rule);
  }
  @media (max-width: 1023px) {
    .group-head h2 {
      grid-column: 1 / span 8;
    }
    .group-head p {
      grid-column: 9 / span 4;
    }
  }
  @media (max-width: 760px) {
    .group-head {
      display: block;
    }
    .group-head p {
      margin-top: 20px;
    }
  }
</style>
