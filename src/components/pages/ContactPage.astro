---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/secondary/ContactForm.astro';
import FactRows from '../../components/secondary/FactRows.astro';
import PageIntro from '../../components/secondary/PageIntro.astro';
import SectionSplit from '../../components/secondary/SectionSplit.astro';
import { pagesCopy } from '../../content/copy';
import { pageMeta } from '../../content/seo';
import { contactFacts } from '../../content/site';
import { getDictionary } from '../../i18n';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pages = pagesCopy[locale];
const copy = pages.contact;
const meta = pageMeta[locale].contact;

// The contact form loads Cloudflare Turnstile (a script and its iframe) from challenges.cloudflare.com. This page, and
// only this page, allows that one origin; every other page keeps the site-wide 'self'-only policy
// (docs/production/contact-form.md, checked by scripts/security/validate.mjs).
// Inserting a resource replaces the configured list, so 'self' (the site's own bundled scripts) is restated.
const csp = Astro.csp;
if (!csp) throw new Error('ContactPage: the CSP API is required (astro.config.mjs security.csp)');
csp.insertScriptResource("'self'");
csp.insertScriptResource('https://challenges.cloudflare.com');
csp.insertDirective('frame-src https://challenges.cloudflare.com');
---

{/* Contact. The lead, the contact form (ContactForm.astro, worker/contact.js), then the three confirmed direct facts:
    email, phone, location, as editorial fact rows, no cards. The direct facts stay: the form adds a way, it replaces
    none. No WhatsApp, social links, office hours, street address or map: none is confirmed. The location is the town only. */}
<BaseLayout locale={locale} page="contact" title={meta.title} description={meta.description} pageType="ContactPage" bleed>
  <PageIntro heading={copy.heading} lead={copy.lead} />
  <SectionSplit id="message" heading={getDictionary(locale).contactForm.heading}>
    <ContactForm locale={locale} />
  </SectionSplit>
  <SectionSplit id="direct" heading={copy.direct}>
    <FactRows
      variant="large"
      rows={[
        { label: copy.email, value: contactFacts.email, href: `mailto:${contactFacts.email}` },
        { label: copy.phone, value: contactFacts.phoneDisplay, href: `tel:${contactFacts.phoneDial}` },
        { label: copy.location, value: copy.locationValue },
      ]}
    />
  </SectionSplit>
  <div class="end"></div>
</BaseLayout>

<style>
  .end {
    height: calc(var(--space-section) * 1.2);
  }
</style>
