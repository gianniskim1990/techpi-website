---
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/locales';
import { contactFacts, operatorFacts } from '../content/site';
import { insightsCopy } from '../content/insights';
import { insightsLocale, insightsPath, legalPages, navPages, pathFor, type LanguageFallback, type PageKey, type Translations } from '../i18n/routes';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  locale: Locale;
  page?: PageKey;
  /** Exact language counterparts for a page outside the route map, passed to the language switch. */
  languageHrefs?: Translations;
  /** Where the switch sends a language the page does not exist in (a one-language page). */
  languageFallbacks?: LanguageFallback;
  /** The canonical path of the current page, where it is outside the route map (marks the Insights link). */
  currentPath?: string;
}

const { locale, page, languageHrefs, languageFallbacks, currentPath } = Astro.props;
const t = getDictionary(locale);
// The same visible navigation as the header, from the route map. In English only, Insights follows EU Projects: the
// articles are English-only, so the Greek footer has no link to them (docs/production/routes.md, section 4.1).
const items = navPages;
const insights = locale === insightsLocale ? { href: insightsPath(), label: insightsCopy.back } : undefined;
---

{/* Minimal. Only what is justified: name, the three approved contact facts (email, phone, town: src/content/site.ts,
     owner-approved 2026-10-07), navigation, language, and a quiet legal line: who operates TechPi and the two
     policies. The street address stays on the Privacy page, not here. */}
<footer class="site-footer s-ink" id="footer" tabindex="-1">
  <div class="top">
    <div class="brand">
      <span class="name">{t.site.name}</span>
      {t.footer.note && <p>{t.footer.note}</p>}
      <address class="contact" aria-label={t.nav.contact}>
        <a href={`mailto:${contactFacts.email}`}>{contactFacts.email}</a>
        <a class="phone" href={`tel:${contactFacts.phoneDial}`}>{contactFacts.phoneDisplay}</a>
        <span>{operatorFacts.town[locale]}</span>
      </address>
    </div>
    <nav aria-label={t.footer.label}>
      <ul>
        {
          items.map((key) => (
            <>
              <li>
                <a href={pathFor(key, locale)}>{t.nav[key]}</a>
              </li>
              {key === 'euProjects' && insights && (
                <li>
                  <a href={insights.href} aria-current={currentPath === insights.href ? 'page' : undefined}>
                    {insights.label}
                  </a>
                </li>
              )}
            </>
          ))
        }
      </ul>
    </nav>
    <div class="lang">
      <LanguageSwitch locale={locale} page={page} hrefs={languageHrefs} fallbacks={languageFallbacks} />
    </div>
  </div>
  <div class="base">
    <p>{t.site.descriptor}</p>
    <p>{operatorFacts.name[locale]} · {operatorFacts.legalForm[locale]} · {operatorFacts.town[locale]}</p>
    <nav class="legal" aria-label={t.footer.legalLabel}>
      <ul>
        {
          legalPages.map((key) => (
            <li>
              <a href={pathFor(key, locale)} aria-current={key === page ? 'page' : undefined}>
                {t.pages[key].heading}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 var(--space-margin);
    font-size: var(--text-small);
  }
  .site-footer:focus {
    outline: none;
  }
  .top {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    row-gap: 40px;
    padding: 72px 0 80px;
  }
  .brand {
    grid-column: 1 / span 4;
    color: var(--sec-c);
  }
  .name {
    display: block;
    color: var(--color-paper);
    font-weight: var(--weight-name);
    letter-spacing: 0.09em;
    font-size: 1rem;
    margin-bottom: 10px;
  }
  /* The contact facts: one quiet column under the name. Links look like the legal links; the town is plain text. */
  .contact {
    display: grid;
    justify-items: start;
    margin-top: 18px;
    font-style: normal;
  }
  .contact a,
  .contact span {
    padding: 6px 0;
  }
  .contact a {
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: var(--line);
    transition: text-decoration-color var(--duration-fast) var(--ease-state);
  }
  .contact a:hover {
    text-decoration-color: currentColor;
  }
  .contact .phone {
    white-space: nowrap;
  }
  nav {
    grid-column: 7 / span 3;
  }
  nav a {
    position: relative;
    display: inline-block;
    padding: 6px 0;
    text-decoration: none;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 240ms var(--ease-reveal);
  }
  nav a:hover::after {
    transform: scaleX(1);
  }
  .lang {
    grid-column: 10 / span 3;
    justify-self: end;
    margin-top: -12px;
  }
  /* The language switch is shared with the header. On Ink its colours are lifted to stay readable. */
  .lang :global(.language-switch a) {
    color: var(--color-fog);
  }
  .lang :global(.language-switch a[aria-current='true']) {
    color: var(--color-paper);
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 32px;
    row-gap: 6px;
    padding: 22px 0 30px;
    border-top: 1px solid var(--line);
    color: var(--sec-c);
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
  }
  .base p + p {
    font-weight: var(--weight-body);
  }
  .legal {
    margin-left: auto;
  }
  .legal ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: 24px;
  }
  .legal a {
    display: inline-block;
    padding: 6px 0;
    color: var(--sec-c);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: var(--line);
    transition:
      color var(--duration-fast) var(--ease-state),
      text-decoration-color var(--duration-fast) var(--ease-state);
  }
  .legal a:hover,
  .legal a[aria-current='page'] {
    color: var(--color-paper);
    text-decoration-color: currentColor;
  }

  @media (max-width: 760px) {
    .top {
      display: block;
      padding: 48px 0 40px;
    }
    .top > * + * {
      margin-top: 28px;
    }
    .lang {
      margin-top: 20px;
      margin-left: -6px;
    }
    .base {
      display: block;
    }
    .base > * + * {
      margin-top: 6px;
    }
    .legal {
      margin-top: 14px;
    }
  }
</style>
