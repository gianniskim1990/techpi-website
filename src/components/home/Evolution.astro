---
import type { HomeCopy } from '../../content/home.en';
import { pathFor } from '../../i18n/routes';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['evolution'];
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

<section class="evo s-paper" id="evolution" aria-labelledby="evo-h">
  <h2 id="evo-h">{copy.heading}</h2>
  <div class="txt">
    <p class="lead">{copy.lead}</p>
    <p class="more">{copy.text}</p>
    <a class="tlink" href={pathFor('about', locale)}>{copy.link}</a>
  </div>
</section>

<style>
  .evo {
    margin: 0 var(--space-margin);
    padding: clamp(80px, 9.5vw, 136px) 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: start;
  }
  h2 {
    grid-column: 1 / span 6;
    font-size: var(--text-display-m);
    line-height: 1.06;
  }
  .txt {
    grid-column: 8 / span 5;
  }
  .lead {
    font-size: var(--text-lead);
    line-height: 1.42;
  }
  .more {
    margin-top: 14px;
    color: var(--sec-c);
    max-width: 40ch;
  }
  .tlink {
    display: inline-block;
    margin-top: 30px;
  }

  @media (max-width: 760px) {
    .evo {
      display: block;
    }
    .txt {
      margin-top: 28px;
    }
  }
</style>
