---
import type { HomeCopy } from '../../content/home.en';
import type { Capability } from '../../content/capabilities';
import { pathFor } from '../../i18n/routes';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['capabilities'];
  items: readonly Capability[];
  locale: Locale;
}

const { copy, items, locale } = Astro.props;
const capabilitiesPath = pathFor('capabilities', locale);
---

{/* Capabilities as editorial statements: a number, a name, one sentence, and what it covers as a quiet run of
    terms. No cards, no icons. On desktop the section heading holds its place while the four statements pass. */}
<section class="caps s-paper" id="capabilities" aria-labelledby="caps-h">
  <div class="head">
    <h2 id="caps-h" data-reveal="mask">{copy.heading}</h2>
  </div>
  <ol class="list">
    {
      items.map((c, i) => (
        <li class="rule" data-reveal="fade">
          <span class="num" aria-hidden="true">
            0{i + 1}
          </span>
          <h3>
            <a class="cap-link" href={`${capabilitiesPath}#${c.id}`}>
              {c.name}
              <span class="arr" aria-hidden="true">
                →
              </span>
            </a>
          </h3>
          <p class="text">{c.summary}</p>
          <ul class="terms">
            {c.items.map((term) => (
              <li>{term}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .caps {
    padding: var(--space-section) var(--space-margin);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: start;
  }
  .head {
    grid-column: 1 / span 4;
    position: sticky;
    top: 112px;
  }
  h2 {
    font-size: var(--text-display-l);
    line-height: 1.02;
    letter-spacing: -0.028em;
  }
  .list {
    grid-column: 5 / span 8;
  }
  .list > li {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    column-gap: var(--space-gap);
    padding: 30px 0 clamp(48px, 5vw, 72px);
  }
  .list > li:last-child {
    padding-bottom: 0;
  }
  .num {
    grid-column: 1 / span 1;
    padding-top: 0.9em;
    color: var(--color-techpi-blue);
  }
  h3 {
    grid-column: 2 / -1;
    font-size: var(--text-display-m);
    line-height: 1.04;
    letter-spacing: -0.024em;
  }
  .text {
    grid-column: 2 / span 6;
    margin-top: 20px;
    color: var(--sec-c);
    font-size: var(--text-lead);
    line-height: 1.42;
    max-width: 40ch;
  }
  /* Separators sit in the gap before each term. A term that starts a new line pushes its separator past the
     left edge, where the list clips it, so no line ever begins with a separator. */
  .terms {
    grid-column: 2 / -1;
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 29px;
    overflow: hidden;
    font-size: var(--text-small);
    color: var(--ter);
  }
  .terms li {
    position: relative;
  }

  /* Each statement leads to its section on the Capabilities page. The whole row is the target. On hover the
     hairline above it redraws in TechPi Blue from the left, the name steps forward and its arrow appears. */
  .list > li {
    position: relative;
  }
  .cap-link {
    text-decoration: none;
    display: inline-block;
    transition: translate 600ms var(--ease-reveal);
  }
  .cap-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cap-link .arr {
    font-size: 0.6em;
    vertical-align: 0.25em;
    margin-left: 0.5em;
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 300ms var(--ease-state),
      transform 600ms var(--ease-reveal);
  }
  .list > li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--color-techpi-blue);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 700ms var(--ease-reveal);
    pointer-events: none;
  }
  .num {
    transition: translate 600ms var(--ease-reveal);
  }
  @media (hover: hover) {
    .list > li:hover::after {
      transform: scaleX(1);
      transform-origin: 0 50%;
    }
    .list > li:hover .cap-link {
      translate: 12px 0;
    }
    .list > li:hover .num {
      translate: 0 -4px;
    }
    .list > li:hover .cap-link .arr {
      opacity: 1;
      transform: none;
    }
  }
  .cap-link:focus-visible {
    outline-offset: 6px;
  }
  .terms li::before {
    content: '';
    position: absolute;
    left: -15px;
    top: 0.3em;
    width: 1px;
    height: 0.95em;
    background: var(--line);
  }

  @media (max-width: 1023px) {
    .caps {
      display: block;
    }
    .head {
      position: static;
    }
    .list {
      margin-top: 56px;
    }
  }

  @media (max-width: 760px) {
    .list {
      margin-top: 44px;
    }
    .list > li {
      display: block;
      padding: 22px 0 44px;
    }
    .num {
      display: block;
      padding: 0 0 14px;
    }
    .text {
      margin-top: 12px;
    }
    .terms {
      margin-top: 16px;
    }
  }
</style>
