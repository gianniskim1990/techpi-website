---
import symbolBlue from '../../assets/brand/techpi-symbol-blue.png';
import BrandSymbol from '../BrandSymbol.astro';
import type { HomeCopy } from '../../content/home.en';
import { pathFor } from '../../i18n/routes';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['contact'];
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

{/* ARC → CIRCLE → TECHPI. The resolution of the page. The arc first seen in the hero, which became a surface edge
    and then a half circle, closes here into a whole circle for the only time on the site, and the circle resolves
    into the approved 3D TechPi symbol, at full strength, on Ink.

    Resting state (no script, reduced motion, print): the closed circle with the symbol inside it. With motion, the
    circle draws itself closed and the symbol settles into it as the section arrives: scroll-driven on desktop
    where supported, otherwise a single timed sequence. Both end exactly at the resting state. */}
<section class="contact s-ink" id="contact" aria-labelledby="contact-h" data-sequence>
  <div class="figure" aria-hidden="true">
    <svg class="ring" focusable="false">
      {/* Pixel units, so the hairline keeps its weight. Turned to start at the left, where the Evolution half circle
          began, and to close clockwise over the top. */}
      <circle cx="50%" cy="50%" r="49.4%" pathLength="1"></circle>
    </svg>
    <div class="mark">
      <BrandSymbol symbol={symbolBlue} sizes="(max-width: 760px) 70vw, (max-width: 1023px) 52vw, min(560px, 40vw)" />
    </div>
  </div>

  <div class="txt">
    <h2 id="contact-h" data-reveal="lines">
      {
        copy.heading.map((line, i) => (
          <>
            <span class="ln" style={`--i:${i}`}>
              <span>{line}</span>
            </span>{' '}
          </>
        ))
      }
    </h2>
    <p class="act" data-reveal="fade" style="--delay:200ms">
      <a class="btn" href={pathFor('contact', locale)}>{copy.cta}</a>
    </p>
  </div>

  <p class="foot rule"><span>{copy.region}</span></p>
</section>

<style>
  .contact {
    position: relative;
    min-height: max(100svh, 760px);
    padding: var(--space-section) var(--space-margin) 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto;
    column-gap: var(--space-gap);
    align-items: center;
    overflow: clip;
    view-timeline-name: --contact;
  }

  .txt {
    grid-column: 1 / span 7;
    grid-row: 1;
    position: relative;
    z-index: 1;
  }
  h2 {
    font-size: clamp(2.5rem, 6.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.034em;
  }
  h2:lang(el) {
    line-height: 1.04;
  }
  h2 .ln {
    display: block;
  }
  .act {
    margin-top: clamp(40px, 4.5vw, 64px);
  }

  /* The circle's box. The symbol fills it with a small margin, so the hairline reads as the symbol's own outer
     edge closing. */
  .figure {
    grid-column: 8 / span 5;
    grid-row: 1;
    justify-self: end;
    position: relative;
    width: min(100%, 64vh, 640px);
    aspect-ratio: 1;
  }
  .ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ring circle {
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(180deg);
    fill: none;
    stroke: var(--color-fog);
    stroke-width: 1.25px;
    opacity: 0.55;
  }
  .mark {
    position: absolute;
    inset: 4.5%;
  }

  .foot {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: clamp(48px, 6vw, 96px);
    padding: 20px 0 28px;
    font-size: var(--text-small);
    color: var(--sec-c);
  }

  /* ---------- Motion ---------- */
  :global(.mo) .ring circle {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 1200ms var(--ease-reveal) 100ms,
      stroke 600ms var(--ease-state) 1200ms,
      opacity 600ms var(--ease-state) 1200ms;
  }
  :global(.mo) .contact:not(.in) .ring circle {
    stroke-dashoffset: 1;
    opacity: 1;
    stroke: var(--color-cyan);
  }
  :global(.mo) .mark {
    transition:
      opacity 1100ms var(--ease-reveal) 700ms,
      transform 1200ms var(--ease-reveal) 700ms;
  }
  :global(.mo) .contact:not(.in) .mark {
    opacity: 0;
    transform: scale(0.9) rotate(-14deg);
  }

  @supports (animation-timeline: view()) {
    @media (min-width: 1024px) {
      :global(.mo) .contact .ring circle {
        transition: none;
        animation: ring-close linear both;
        animation-timeline: --contact;
        animation-range: entry 15% cover 45%;
      }
      :global(.mo) .contact .mark {
        transition: none;
        animation: mark-resolve linear both;
        animation-timeline: --contact;
        animation-range: entry 70% cover 52%;
      }
    }
  }
  @keyframes ring-close {
    0% {
      stroke-dashoffset: 1;
      stroke: var(--color-cyan);
      opacity: 1;
    }
    75% {
      stroke-dashoffset: 0;
      stroke: var(--color-cyan);
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      stroke: var(--color-fog);
      opacity: 0.55;
    }
  }
  @keyframes mark-resolve {
    from {
      opacity: 0;
      transform: scale(0.9) rotate(-14deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Tablet and phone: the figure first, then the question ---------- */
  @media (max-width: 1023px) {
    .contact {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-top: 104px;
    }
    .figure {
      order: -1;
      align-self: center;
      width: min(64vw, 440px);
    }
    .txt {
      margin-top: 64px;
    }
    .foot {
      margin-top: 88px;
    }
  }
  @media (max-width: 760px) {
    .contact {
      padding-top: 88px;
    }
    .figure {
      width: min(72vw, 340px);
    }
    .txt {
      margin-top: 52px;
    }
    .act .btn {
      display: flex;
    }
    .foot {
      margin-top: 72px;
    }
  }
</style>
