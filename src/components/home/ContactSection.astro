---
import symbolWhite from '../../assets/brand/techpi-symbol-white.png';
import BrandSymbol from '../BrandSymbol.astro';
import type { HomeCopy } from '../../content/home.en';
import { pathFor } from '../../i18n/routes';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['contact'];
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

{/* ARC to CIRCLE to TECHPI, the static resting state. The arc that crosses the page has closed into the circle,
    and the circle has resolved into the approved TechPi symbol: white, tone on tone behind the question.
    `.mark` is the circle's box (the same size and position the hairline ring had), and the symbol's outer ring
    fills it. Phase 3E animates into this state (arc closes, inner geometry appears). It must end exactly here. */}
<section class="contact s-blue" id="contact" aria-labelledby="contact-h">
  <div class="mark">
    <BrandSymbol symbol={symbolWhite} sizes="(max-width: 760px) calc(100vw - 32px), min(760px, 78vh, 88vw)" />
  </div>
  <div class="mid">
    <h2 id="contact-h">
      {copy.heading.map((line) => <><span class="ln">{line}</span>{" "}</>)}
    </h2>
    <a class="btn" href={pathFor('contact', locale)}>{copy.cta}</a>
  </div>
  <p class="foot"><span>{copy.region}</span></p>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    min-height: max(100svh, 760px);
    padding: 0 var(--space-margin);
    display: grid;
    place-items: center;
  }
  /* Decorative: the image has an empty alt. Tone on tone, so it supports the question and never competes with it.
     16%: the 3D shading averages darker than the prototype's flat white at 14%, so this gives the same weight. */
  .mark {
    position: absolute;
    left: 50%;
    top: 47%;
    width: min(760px, 78vh, 88vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    opacity: 0.16;
    pointer-events: none;
  }
  .mid {
    position: relative;
    margin-top: -6vh;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 44px;
  }
  h2 {
    font-size: clamp(2.125rem, 5.6vw, 5rem);
    line-height: 1.02;
  }
  h2 .ln {
    display: block;
  }
  .foot {
    position: absolute;
    left: var(--space-margin);
    right: var(--space-margin);
    bottom: 36px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: var(--text-small);
  }

  @media (max-width: 760px) {
    .contact {
      min-height: max(100svh, 700px);
      display: block;
    }
    .mark {
      top: 112px;
      width: calc(100vw - 32px);
      transform: translateX(-50%);
    }
    .mid {
      position: static;
      margin: 0;
      display: block;
    }
    h2 {
      position: absolute;
      left: 44px;
      right: 44px;
      top: 112px;
      height: calc(100vw - 32px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 2.25rem;
      line-height: 1.08;
    }
    .btn {
      position: absolute;
      left: var(--space-margin);
      right: var(--space-margin);
      top: calc(112px + 100vw - 32px + 36px);
    }
    .foot {
      bottom: 24px;
    }
  }
</style>
