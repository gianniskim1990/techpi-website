---
import type { HomeCopy } from '../../content/home.en';
import { pathFor } from '../../i18n/routes';
import { Image } from 'astro:assets';
import EuHeroPanel from './EuHeroPanel.astro';
import TransformationMap from './TransformationMap.astro';
import { heroVisuals } from './hero-visual';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['hero'];
  locale: Locale;
}

const { copy, locale } = Astro.props;
// The Greek homepage has a photograph (hero-visual.ts); the English homepage has the EU projects panel instead
// (EuHeroPanel.astro), which says what TechPi builds for EU-funded projects. Chosen at build time from the locale.
const visual = heroVisuals[locale];
---

{/* ARC. The first state of the one geometric idea that runs through the homepage: a segment of a circle far
    larger than the screen. Here it is only ever an arc. It thickens into a surface edge (Selected work), opens to a
    half circle (Evolution) and closes into the TechPi symbol (Contact).

    The h1 is the first paint. Its lines rise out of their masks with a CSS-only animation that never waits for a
    script, and only when motion is allowed. The arc draws itself once. Both rest exactly where the static page is.
    When the intro plays they play under its blurred backdrop (src/components/home/Intro.astro) and are at rest
    when it clears. */}
<section class="hero s-paper" aria-labelledby="hero-h" data-scene>
  <div class="stage" class:list={{ eu: !visual }}>
    {!visual && <EuHeroPanel />}
    {/* The visual: one real image in the corner the arc opens, clipped by the arc's own circle so the arc is its edge.
        Its bottom edge is the map's line (--map-b, measured by src/scripts/motion.ts). On tablets and phones, where the
        arc is too small to frame anything, it is a quiet band above the map. Decorative. */}
    {visual && (
    <div class="visual" aria-hidden="true">
      <div class="frame">
        <Image
          src={visual.image}
          alt=""
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) calc(100vw - 40px), 704px"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="low"
          decoding="async"
          style={`object-position:${visual.focus}`}
        />
      </div>
    </div>
    )}
    <svg class="arc" aria-hidden="true" focusable="false">
      {/* A circle in pixel units, so the hairline keeps its exact weight. Turned so the stroke starts just
          above the top edge of the window and runs down to the right edge when it draws. */}
      <circle cx="50%" cy="50%" r="49.95%" pathLength="1"></circle>
    </svg>
    <TransformationMap copy={copy.map} />
    <h1 id="hero-h" class="statement">
      {
        copy.statement.map((line, i) => (
          <>
            <span class="ln" style={`--i:${i}`}>
              <span>{line}</span>
            </span>{' '}
          </>
        ))
      }
    </h1>
    <div class="foot rule">
      <p class="meta">{copy.meta}</p>
      <p class="support">
        {
          copy.support.map((line) => (
            <>
              <span class="ln">{line}</span>{' '}
            </>
          ))
        }
      </p>
      <p class="act">
        <a class="btn" href={pathFor('contact', locale)}>{copy.start}<span class="arr" aria-hidden="true">→</span></a>
        <a class="tlink" href="#work">{copy.work}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .stage {
    position: relative;
    overflow: clip;
    /* No longer the full height of a tall window: on a 1080 px screen the content ends where it ends and the next
       section shows below it, instead of the hero padding itself out with empty space. */
    min-height: max(min(100svh, 880px), 680px);
    padding: 120px var(--space-margin) 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* English desktop: the map is taller, so the EU projects panel beside it has room to be read (EuHeroPanel.astro). The
     map's own design is unchanged: its curves stretch and its labels keep their places. */
  @media (min-width: 901px) {
    .hero .stage.eu :global(.tmap) {
      height: clamp(300px, 45vh, 460px);
    }
  }

  .statement {
    position: relative;
    font-size: var(--text-display-xxl);
    line-height: 0.96;
    letter-spacing: -0.034em;
  }
  .statement .ln {
    display: block;
  }
  .statement:lang(el) {
    line-height: 1.02;
  }

  .foot {
    position: relative;
    margin-top: clamp(44px, 6vh, 80px);
    padding-top: 22px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: start;
  }
  .meta {
    grid-column: 1 / span 4;
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    color: var(--ter);
    padding-top: 0.5em;
  }
  .support {
    grid-column: 5 / span 5;
    font-size: clamp(1.25rem, 1.95vw, 1.75rem);
    line-height: 1.26;
    letter-spacing: -0.012em;
    color: var(--sec-c);
  }
  .support .ln {
    display: block;
  }
  .act {
    grid-column: 10 / span 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 0.3em;
  }
  /* On desktop the call to action stays quiet: the header already carries Contact. It returns on phones. */
  .act .btn {
    display: none;
  }

  /* The visual. Desktop: the layer is the whole stage, clipped to the arc's circle (the same centre and radius as .arc
     below), so the picture fills the corner the arc opens and the arc hairline is its curved edge. The frame sits
     between the header and the map's line (--map-b, measured by motion.ts; the fallback is the resting position). */
  .visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    clip-path: circle(1412.6px at calc(100% + 350px) -900px);
  }
  .frame {
    position: absolute;
    right: 0;
    /* It stops 34 px above the map's line: the label of the line's end ("Digital products") sits in that gap, on Paper. */
    bottom: calc(100% - var(--map-b, 402px) + 34px);
    width: 704px;
    height: min(calc(var(--map-b, 402px) - 126px), 400px);
    overflow: hidden;
    background: var(--color-ink-raised);
  }
  /* A hairline around the picture, like the arc: a light photograph would otherwise melt into the Paper. */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgb(8 14 30 / 0.16);
    pointer-events: none;
  }
  /* The picture is a little taller than its frame, so the scroll shift never shows an edge. */
  .frame :global(img) {
    position: absolute;
    left: 0;
    top: -40px;
    width: 100%;
    height: calc(100% + 80px);
    object-fit: cover;
  }

  /* The arc: the outer sweep of the TechPi symbol, far larger than the screen. Hand-cropped per breakpoint so it
     crosses the top edge between the name and the navigation, and never touches the text. */
  .arc {
    position: absolute;
    width: 2828px;
    height: 2828px;
    left: calc(100% - 1064px);
    top: -2314px;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }
  .arc circle {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.25px;
    transition: stroke 700ms var(--ease-state);
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(146deg) scaleY(-1);
  }

  /* When the reader hovers the transformation map, the trace reaches the arc and the arc turns TechPi Blue for as
     long as the pointer stays: the connected system has become TechPi. */
  @media (hover: hover) {
    .stage:has(:global(.tmap:hover)) .arc circle {
      stroke: var(--color-techpi-blue);
      transition-delay: 1300ms;
    }
  }

  /* Tablet: the statement spans the width, the support line moves under it. */
  @media (max-width: 1023px) {
    .meta {
      grid-column: 1 / span 3;
    }
    .support {
      grid-column: 4 / span 5;
    }
    .act {
      grid-column: 1 / -1;
      justify-self: start;
      margin-top: 28px;
    }
  }

  @media (max-width: 900px) {
    /* The arc is too small here to frame a picture: the visual becomes a band above the map, between the header and
       the diagram, in the space that used to stand empty. */
    /* It takes whatever height the window has left over (up to 240 px), and never fewer than that minimum, so the first screen
       keeps its headline and its calls to action where they were. */
    .visual {
      position: relative;
      inset: auto;
      clip-path: none;
      flex: 1 1 0;
      /* 96 px on phones, growing to 150 px on tablets, which have the height to spare. */
      min-height: clamp(96px, 20vw - 4px, 150px);
      max-height: 240px;
      margin-bottom: 22px;
    }
    .frame {
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .arc {
      width: 984px;
      height: 984px;
      left: calc(100% - 336px);
      top: -800px;
    }
    .arc circle {
      stroke-width: 1.1px;
    }
  }

  /* The header's name now carries its symbol, so it is wider: on the narrowest phones the arc crosses the top edge 25px
     further right, to stay between the name and the language switch. */
  @media (max-width: 349px) {
    .arc {
      left: calc(100% - 311px);
    }
  }

  @media (max-width: 760px) {
    .stage {
      min-height: 100svh;
      padding-top: 92px;
      padding-bottom: 32px;
    }
    .statement {
      line-height: 1.02;
      letter-spacing: -0.028em;
    }
    .foot {
      display: flex;
      flex-direction: column;
      margin-top: 36px;
      padding-top: 18px;
    }
    .support {
      order: -1;
      font-size: 1.1875rem;
      line-height: 1.38;
      letter-spacing: 0;
    }
    .support .ln {
      display: inline;
    }
    .meta {
      margin-top: 18px;
      padding-top: 0;
    }
    .act {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-top: 30px;
      padding-top: 0;
    }
    .act .btn {
      display: inline-flex;
    }
  }

  /* ---------- Motion (only under html.mo: scripting runs and motion is allowed) ---------- */

  /* The statement lines rise out of their masks on first paint. CSS only: the h1 never waits for a script. */
  :global(.mo) .statement .ln {
    overflow: clip;
    padding: 0.1em 0 0.14em;
    margin: -0.1em 0 -0.14em;
  }
  :global(.mo) .statement .ln > span {
    display: block;
    animation: hero-line 1000ms var(--ease-reveal) both;
    animation-delay: calc(120ms + var(--i, 0) * 90ms);
  }
  @keyframes hero-line {
    from {
      transform: translateY(108%);
    }
  }
  @media (max-width: 760px) {
    :global(.mo) .statement .ln {
      display: inline;
      overflow: visible;
      padding: 0;
      margin: 0;
    }
    :global(.mo) .statement .ln > span {
      display: inline;
      animation-name: hero-fade;
      animation-duration: 700ms;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  :global(.mo) .foot > * {
    animation: hero-fade 900ms var(--ease-reveal) both;
    animation-delay: 620ms;
  }
  :global(.mo) .foot.rule::before {
    animation: hero-rule 1100ms var(--ease-reveal) both;
    animation-delay: 420ms;
  }
  @keyframes hero-rule {
    from {
      transform: scaleX(0);
    }
  }

  /* The visual arrives after the headline has settled: the picture eases in from a slightly larger size while the
     frame fades up. Opacity and transform only, once, about a second and a half. */
  :global(.mo) .frame {
    animation: hero-fade 1300ms var(--ease-reveal) both;
    animation-delay: 380ms;
  }
  :global(.mo) .frame :global(img) {
    animation: hero-visual-in 1700ms var(--ease-reveal) both;
    animation-delay: 380ms;
  }
  @keyframes hero-visual-in {
    from {
      transform: scale(1.07);
    }
  }

  /* The arc draws itself once, from the top edge to the right edge of the window. */
  :global(.mo) .arc circle {
    stroke-dasharray: 1;
    stroke-dashoffset: 0.865;
    animation: arc-draw 1200ms var(--ease-reveal) both;
    animation-delay: 260ms;
  }
  @keyframes arc-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* Scroll scene (html.sc): as the hero leaves, its layers part at different depths. The statement lines lift
     faster than the page, each a little less than the one above; the arc, furthest back, holds and drifts down.
     Uses the individual `translate` property, so it never competes with the load animation's `transform`. */
  :global(.sc) .statement .ln {
    translate: 0 calc(var(--out, 0) * (-18vh + var(--i, 0) * 6vh));
  }
  :global(.sc) .foot {
    translate: 0 calc(var(--out, 0) * -6vh);
    opacity: calc(1 - var(--out, 0) * 1.8);
  }
  :global(.sc) .arc {
    translate: calc(var(--out, 0) * -6vw) calc(var(--out, 0) * 30vh);
  }
  /* The picture is the furthest layer: it sinks slowly inside its frame while the page rises past it (40 px at most,
     the margin the picture has above its frame), and the frame itself leaves with the foot. */
  :global(.sc) .frame :global(img) {
    translate: 0 calc(var(--out, 0) * 40px);
  }
  :global(.sc) .frame {
    opacity: calc(1 - var(--out, 0) * 1.4);
  }
</style>
