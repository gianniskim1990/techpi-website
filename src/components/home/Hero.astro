---
import Arrowed from '../Arrowed.astro';
import type { HomeCopy } from '../../content/home.en';
import { pathFor } from '../../i18n/routes';
import TransformationMap from './TransformationMap.astro';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['hero'];
  locale: Locale;
}

const { copy, locale } = Astro.props;
---

{/* ARC. The first state of the one geometric idea that runs through the homepage: a segment of a circle far
    larger than the screen. Here it is only ever an arc. It thickens into a surface edge (Selected work), opens to a
    half circle (Evolution) and closes into the TechPi symbol (Contact).

    The h1 is the first paint. Its lines rise out of their masks with a CSS-only animation that never waits for a
    script, and only when motion is allowed. The arc draws itself once. Both rest exactly where the static page is. */}
<section class="hero s-paper" aria-labelledby="hero-h" data-scene>
  <div class="stage">
    <svg class="arc" aria-hidden="true" focusable="false">
      {/* A circle in pixel units, so the hairline keeps its exact weight. Turned so the stroke starts just
          above the top edge of the window and runs down to the right edge when it draws. */}
      <circle cx="50%" cy="50%" r="49.95%" pathLength="1"></circle>
    </svg>
    <TransformationMap copy={copy.map} />
    <h1 id="hero-h" class="statement">
      {
        copy.statement.map((line, i) => (
          <>
            <span class="ln" style={`--i:${i}`}>
              <span>{line}</span>
            </span>{' '}
          </>
        ))
      }
    </h1>
    <div class="foot rule">
      <p class="meta">{copy.meta}</p>
      <p class="support">
        {
          copy.support.map((line) => (
            <>
              <span class="ln">{line}</span>{' '}
            </>
          ))
        }
      </p>
      <p class="act">
        <a class="btn" href={pathFor('contact', locale)}><Arrowed text={copy.start} /></a>
        <a class="tlink" href="#work">{copy.work}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .stage {
    position: relative;
    overflow: clip;
    min-height: max(100svh, 720px);
    padding: 168px var(--space-margin) 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .statement {
    position: relative;
    font-size: var(--text-display-xxl);
    line-height: 0.96;
    letter-spacing: -0.034em;
  }
  .statement .ln {
    display: block;
  }
  .statement:lang(el) {
    line-height: 1.02;
  }

  .foot {
    position: relative;
    margin-top: clamp(44px, 6vh, 80px);
    padding-top: 22px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: start;
  }
  .meta {
    grid-column: 1 / span 4;
    font-size: var(--text-label);
    font-weight: var(--weight-ui);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ter);
    padding-top: 0.45em;
  }
  .support {
    grid-column: 5 / span 5;
    font-size: clamp(1.25rem, 1.95vw, 1.75rem);
    line-height: 1.26;
    letter-spacing: -0.012em;
    color: var(--sec-c);
  }
  .support .ln {
    display: block;
  }
  .act {
    grid-column: 10 / span 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 0.3em;
  }
  /* On desktop the call to action stays quiet: the header already carries Contact. It returns on phones. */
  .act .btn {
    display: none;
  }

  /* The arc: the outer sweep of the TechPi symbol, far larger than the screen. Hand-cropped per breakpoint so it
     crosses the top edge between the name and the navigation, and never touches the text. */
  .arc {
    position: absolute;
    width: 2828px;
    height: 2828px;
    left: calc(100% - 1064px);
    top: -2314px;
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }
  .arc circle {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.25px;
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(146deg) scaleY(-1);
  }

  /* Tablet: the statement spans the width, the support line moves under it. */
  @media (max-width: 1023px) {
    .meta {
      grid-column: 1 / span 3;
    }
    .support {
      grid-column: 4 / span 5;
    }
    .act {
      grid-column: 1 / -1;
      justify-self: start;
      margin-top: 28px;
    }
  }

  @media (max-width: 900px) {
    .arc {
      width: 984px;
      height: 984px;
      left: calc(100% - 336px);
      top: -800px;
    }
    .arc circle {
      stroke-width: 1.1px;
    }
  }

  @media (max-width: 760px) {
    .stage {
      min-height: 100svh;
      padding-top: 132px;
      padding-bottom: 32px;
    }
    .statement {
      line-height: 1.02;
      letter-spacing: -0.028em;
    }
    .foot {
      display: flex;
      flex-direction: column;
      margin-top: 36px;
      padding-top: 18px;
    }
    .support {
      order: -1;
      font-size: 1.1875rem;
      line-height: 1.38;
      letter-spacing: 0;
    }
    .support .ln {
      display: inline;
    }
    .meta {
      margin-top: 18px;
      padding-top: 0;
    }
    .act {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-top: 30px;
      padding-top: 0;
    }
    .act .btn {
      display: inline-flex;
    }
  }

  /* ---------- Motion (only under html.mo: scripting runs and motion is allowed) ---------- */

  /* The statement lines rise out of their masks on first paint. CSS only: the h1 never waits for a script. */
  :global(.mo) .statement .ln {
    overflow: clip;
    padding: 0.1em 0 0.14em;
    margin: -0.1em 0 -0.14em;
  }
  :global(.mo) .statement .ln > span {
    display: block;
    animation: hero-line 1000ms var(--ease-reveal) both;
    animation-delay: calc(120ms + var(--i, 0) * 90ms);
  }
  @keyframes hero-line {
    from {
      transform: translateY(108%);
    }
  }
  @media (max-width: 760px) {
    :global(.mo) .statement .ln {
      display: inline;
      overflow: visible;
      padding: 0;
      margin: 0;
    }
    :global(.mo) .statement .ln > span {
      display: inline;
      animation-name: hero-fade;
      animation-duration: 700ms;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  :global(.mo) .foot > * {
    animation: hero-fade 900ms var(--ease-reveal) both;
    animation-delay: 620ms;
  }
  :global(.mo) .foot.rule::before {
    animation: hero-rule 1100ms var(--ease-reveal) both;
    animation-delay: 420ms;
  }
  @keyframes hero-rule {
    from {
      transform: scaleX(0);
    }
  }

  /* The arc draws itself once, from the top edge to the right edge of the window. */
  :global(.mo) .arc circle {
    stroke-dasharray: 1;
    stroke-dashoffset: 0.865;
    animation: arc-draw 1200ms var(--ease-reveal) both;
    animation-delay: 260ms;
  }
  @keyframes arc-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* Scroll scene (html.sc): as the hero leaves, its layers part at different depths. The statement lines lift
     faster than the page, each a little less than the one above; the arc, furthest back, holds and drifts down.
     Uses the individual `translate` property, so it never competes with the load animation's `transform`. */
  :global(.sc) .statement .ln {
    translate: 0 calc(var(--out, 0) * (-18vh + var(--i, 0) * 6vh));
  }
  :global(.sc) .foot {
    translate: 0 calc(var(--out, 0) * -6vh);
    opacity: calc(1 - var(--out, 0) * 1.8);
  }
  :global(.sc) .arc {
    translate: calc(var(--out, 0) * -6vw) calc(var(--out, 0) * 30vh);
  }
</style>
