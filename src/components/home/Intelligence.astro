---
import type { HomeCopy } from '../../content/home.en';

interface Props {
  copy: HomeCopy['intelligence'];
}

const { copy } = Astro.props;
---

{/* Exact Paper. Set apart from its neighbours by one hairline, space and scale, not by another colour.
    Wording is capability-oriented: it does not claim any of this has been delivered. */}
<section class="intel s-paper" id="intelligence" aria-labelledby="intel-h">
  <h2 id="intel-h">
    {copy.heading.map((line) => <><span class="ln">{line}</span>{" "}</>)}
  </h2>
  <div class="body">
    <p class="lead">{copy.lead}</p>
    <dl class="areas">
      {
        copy.areas.map((a) => (
          <div>
            <dt>{a.title}</dt>
            <dd>{a.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .intel {
    margin: 0 var(--space-margin);
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: var(--text-display-l);
    line-height: 1.02;
  }
  h2 .ln {
    display: block;
  }
  .body {
    margin-top: clamp(56px, 8vw, 120px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .lead {
    grid-column: 1 / span 5;
    font-size: var(--text-lead);
    line-height: 1.42;
    max-width: 30ch;
  }
  .areas {
    grid-column: 7 / span 6;
  }
  .areas div {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--space-gap);
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .areas div:last-child {
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-weight: var(--weight-ui);
  }
  dd {
    color: var(--sec-c);
  }

  @media (max-width: 760px) {
    h2 .ln {
      display: inline;
    }
    .body {
      display: block;
      margin-top: 40px;
    }
    .areas {
      margin-top: 48px;
    }
    .areas div {
      display: block;
      padding: 16px 0;
    }
    dd {
      margin-top: 4px;
    }
  }
</style>
