---
import Unbroken from '../Unbroken.astro';
import { euCopy } from '../../content/eu';
import { pathFor } from '../../i18n/routes';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = euCopy[locale];
---

{/* EU-funded projects, as a market TechPi serves: a service statement, not a portfolio. One large sentence, the
    supporting line, and what can be built as a single typographic run, not a grid of cards. One quiet way on. No EU
    flag, no stars, no blue and yellow: the identity stays TechPi's. */}
<section class="eu s-paper" id="eu-projects" aria-labelledby="eu-h" data-scene>
  <div class="top rule" data-reveal="fade">
    <p class="meta-label">{copy.home.label}</p>
  </div>
  <h2 id="eu-h" data-reveal="mask"><Unbroken text={copy.home.heading} /></h2>
  <p class="text" data-reveal="fade" style="--delay:120ms">{copy.home.text}</p>
  <ul class="run" data-reveal="fade" style="--delay:200ms">
    {copy.home.items.map((item) => <li>{item}</li>)}
  </ul>
  {/* Last in reading order; on desktop it sits at the right end of the top line. */}
  <p class="more" data-reveal="fade">
    <a class="tlink" href={pathFor('euProjects', locale)}>
      {copy.home.cta}<span class="arr" aria-hidden="true">→</span>
    </a>
  </p>
</section>

<style>
  .eu {
    padding: var(--space-block) var(--space-margin) var(--space-section);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .top {
    grid-column: 1 / -1;
    grid-row: 1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-top: 20px;
  }
  .more {
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    padding-top: 17px;
  }
  h2 {
    grid-column: 1 / span 9;
    margin-top: clamp(48px, 6vw, 96px);
    font-size: var(--text-display-l);
    line-height: 1.02;
    letter-spacing: -0.028em;
  }
  h2:lang(el) {
    line-height: 1.08;
  }
  .text {
    grid-column: 5 / span 6;
    margin-top: clamp(32px, 3.4vw, 48px);
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--sec-c);
  }

  /* What can be built, as one run of text in the content column: each item a phrase, with a small hairline circle
     between items (the site's shape, at the size of punctuation). The circle sits in the gap before an item; an
     item that starts a line pushes its circle past the left edge, where the list clips it. */
  .run {
    grid-column: 5 / span 8;
    margin-top: clamp(40px, 4.5vw, 64px);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 46px;
    overflow: hidden;
    font-size: var(--text-heading);
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .run li {
    position: relative;
  }
  .run li::before {
    content: '';
    position: absolute;
    left: -28px;
    top: 0.48em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--color-slate);
  }

  /* Scroll scene: the sentence arrives on the page's tempo; the run trails a little. */
  :global(.sc) h2 {
    translate: 0 calc((1 - var(--in, 1)) * 8vh);
  }
  :global(.sc) .run {
    translate: 0 calc((1 - var(--in, 1)) * 18vh);
  }

  @media (max-width: 1023px) {
    .eu {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    h2 {
      grid-column: 1 / -1;
    }
    .text,
    .run {
      grid-column: 2 / -1;
    }
  }
  @media (max-width: 760px) {
    .eu {
      display: block;
    }
    .more {
      margin-top: 40px;
      padding-top: 0;
    }
    .run {
      font-size: 1.1875rem;
      gap: 6px 32px;
    }
    .run li::before {
      left: -20px;
      width: 7px;
      height: 7px;
    }
  }
</style>
