---
import type { HomeCopy } from '../../content/home.en';
import Crop from '../Crop.astro';
import { compositions, type Composition } from '../workCompositions';
import { capabilityName } from '../../content/capabilities';
import type { Project } from '../../content/projects';
import { caseStudyPath, pathFor } from '../../i18n/routes';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['work'];
  projects: readonly Project[];
  locale: Locale;
}

const { copy, projects, locale } = Astro.props;
const facts = (p: Project) => p.capabilities.map((id) => capabilityName(id, locale)).join(', ');
const fallback: Composition = { layout: 'bleed', main: { caption: { en: '', el: '' } } };
---

{/* Selected work: the Ink chapter. Each project is composed from its own real captures, cropped to the part worth
    looking at, so the three read as three projects rather than one template: a layered interface (Rocketeer), a
    capture running off the page with a detail beside it (Arman's), a full-width strip (Logotherapia). No sticky
    stacking, no hover zoom: the page simply scrolls through them. */}
<section class="work s-ink" id="work" aria-labelledby="work-h">
  <div class="work-head">
    <h2 id="work-h">{copy.heading}</h2>
    <a class="tlink all" href={pathFor('work', locale)}>{copy.all}</a>
  </div>
  {
    projects.map((p) => {
      const c = compositions[p.slug] ?? fallback;
      const href = p.caseStudy ? caseStudyPath(p.slug, locale) : undefined;
      const detailImage = c.detail ? p.caseStudy?.gallery?.[c.detail.index] : undefined;
      const mainCaption = c.main.caption[locale];
      return (
        <article class={`case case-${c.layout}`} id={`case-${p.slug}`} aria-labelledby={`case-${p.slug}-h`}>
          <div class="txt">
            <div class="id">
              <p class="meta-label">{p.category}</p>
              <h3 id={`case-${p.slug}-h`}>{p.name}</h3>
            </div>
            <div class="info">
              <p class="sum">{p.summary}</p>
              <dl class="facts">
                <dt>{copy.factsLabel}</dt>
                <dd>{facts(p)}</dd>
              </dl>
              {href && (
                <a class="tlink" href={href} aria-label={`${copy.caseLink}: ${p.name}`}>
                  {copy.caseLink}
                </a>
              )}
            </div>
          </div>
          {p.image && (
            <figure class="main">
              <a class="frame" href={href} tabindex="-1" aria-hidden="true">
                <Crop image={p.image} alt="" crop={c.main.crop} small={c.main.small} vw={c.layout === 'band' ? [100, 100] : [70, 100]} />
              </a>
              {mainCaption && <figcaption>{mainCaption}</figcaption>}
            </figure>
          )}
          {c.detail && detailImage && (
            <figure class="detail">
              <div class="frame">
                <Crop image={detailImage} alt="" crop={c.detail.crop} vw={[30, 50]} />
              </div>
              <figcaption>{c.detail.caption[locale]}</figcaption>
            </figure>
          )}
        </article>
      );
    })
  }
</section>

<style>
  .work {
    padding: clamp(96px, 10vw, 152px) var(--space-margin) clamp(104px, 11vw, 168px);
  }
  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }
  h2 {
    font-size: var(--text-display-m);
    line-height: 1;
    letter-spacing: -0.024em;
  }
  .all {
    white-space: nowrap;
  }

  /* ---------- One project ---------- */
  .case {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    margin-top: clamp(88px, 10vw, 160px);
  }
  .work-head + .case {
    margin-top: clamp(56px, 6vw, 96px);
  }
  .txt {
    display: contents;
  }
  .meta-label {
    color: var(--color-fog);
  }
  h3 {
    margin-top: 10px;
    font-size: var(--text-display-l);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .sum {
    font-size: var(--text-lead);
    line-height: 1.38;
    max-width: 34ch;
  }
  .facts {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    font-size: var(--text-small);
    color: var(--color-fog);
  }
  .facts dt::after {
    content: ':';
  }
  .facts dd {
    color: var(--color-paper);
  }
  .info .tlink {
    display: inline-block;
    margin-top: 24px;
  }

  figure {
    position: relative;
  }
  .frame {
    display: block;
    background: var(--color-ink-raised);
  }
  figcaption {
    margin-top: 12px;
    font-size: var(--text-label);
    color: var(--color-fog);
  }

  /* ---------- Layered: Rocketeer ----------
     The dashboard at a scale where its interface reads, and the sign-in screen laid over its lower right corner,
     cut out of the dashboard by a band of Ink, hanging below it. */
  .case-layered .id {
    grid-column: 1 / span 7;
    grid-row: 1;
  }
  .case-layered .info {
    grid-column: 9 / span 4;
    grid-row: 1;
    align-self: end;
  }
  .case-layered .main {
    grid-column: 1 / span 10;
    grid-row: 2;
    margin-top: clamp(40px, 4.5vw, 64px);
  }
  .case-layered .detail {
    grid-column: 9 / span 4;
    grid-row: 2;
    align-self: end;
    z-index: 1;
    width: 78%;
    justify-self: end;
    translate: 0 clamp(64px, 9vw, 136px);
    margin-bottom: clamp(64px, 9vw, 136px);
  }
  .case-layered .detail .frame {
    box-shadow: 0 0 0 clamp(8px, 0.9vw, 14px) var(--color-ink);
  }

  /* ---------- Bleed: Arman's ----------
     The capture runs off the right edge of the page; the text holds the left, and a detail of the management area
     sits low under it, small, as evidence of the system behind the site. */
  .case-bleed .id {
    grid-column: 1 / span 4;
    grid-row: 1;
  }
  .case-bleed .id h3 {
    font-size: var(--text-display-m);
    line-height: 1.02;
  }
  .case-bleed .info {
    grid-column: 1 / span 4;
    grid-row: 2;
    margin-top: 28px;
  }
  .case-bleed .main {
    grid-column: 6 / -1;
    grid-row: 1 / span 3;
    margin-right: calc(-1 * var(--space-margin));
  }
  .case-bleed .main figcaption {
    padding-right: var(--space-margin);
  }
  .case-bleed .detail {
    grid-column: 1 / span 4;
    grid-row: 3;
    align-self: end;
    margin-top: 48px;
  }

  /* ---------- Band: Logotherapia ----------
     One capture as a strip across the full width of the window, then the text in a single compact row. */
  .case-band .main {
    grid-column: 1 / -1;
    grid-row: 1;
    margin: 0 calc(-1 * var(--space-margin));
  }
  .case-band .main figcaption {
    padding: 0 var(--space-margin);
  }
  .case-band .id {
    grid-column: 1 / span 5;
    grid-row: 2;
    margin-top: clamp(32px, 3.6vw, 52px);
  }
  .case-band .id h3 {
    font-size: var(--text-display-m);
    line-height: 1.02;
  }
  .case-band .info {
    grid-column: 7 / span 6;
    grid-row: 2;
    margin-top: clamp(32px, 3.6vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    column-gap: var(--space-gap);
    align-items: start;
  }
  .case-band .sum {
    grid-row: 1 / span 2;
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-paper);
  }
  .case-band .facts {
    margin-top: 0.15em;
  }
  .case-band .info .tlink {
    grid-column: 2;
    justify-self: start;
    margin-top: 14px;
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1023px) {
    .case {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .case-layered .id {
      grid-column: 1 / -1;
    }
    .case-layered .info {
      grid-column: 1 / span 6;
      grid-row: 3;
      margin-top: 40px;
    }
    .case-layered .main {
      grid-column: 1 / span 7;
    }
    .case-layered .detail {
      grid-column: 5 / span 4;
      width: 82%;
      translate: 0 48px;
      margin-bottom: 48px;
    }
    .case-bleed .id {
      grid-column: 1 / -1;
    }
    .case-bleed .main {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 36px;
    }
    .case-bleed .info {
      grid-column: 1 / span 5;
      grid-row: 3;
      margin-top: 36px;
    }
    .case-bleed .detail {
      grid-column: 6 / span 3;
      grid-row: 3;
      align-self: start;
      margin-top: 36px;
    }
    .case-band .id {
      grid-column: 1 / -1;
    }
    .case-band .info {
      grid-column: 1 / span 7;
      grid-row: 3;
      margin-top: 24px;
    }
  }

  /* ---------- Phone: one strong crop per project, edge to edge ---------- */
  @media (max-width: 760px) {
    .work {
      padding-top: 88px;
    }
    .work-head {
      flex-direction: column;
      gap: 16px;
    }
    .case {
      display: flex;
      flex-direction: column;
      margin-top: 88px;
    }
    .work-head + .case {
      margin-top: 52px;
    }
    .id {
      order: 1;
    }
    .main {
      order: 2;
      margin: 28px calc(-1 * var(--space-margin)) 0 !important;
    }
    .main figcaption {
      padding: 0 var(--space-margin);
    }
    .detail {
      order: 3;
    }
    .info {
      order: 4;
      margin-top: 28px !important;
    }
    h3,
    .case-bleed .id h3,
    .case-band .id h3 {
      font-size: clamp(2rem, 9vw, 2.5rem);
    }
    .case-layered .detail {
      align-self: flex-end;
      width: 48%;
      translate: none;
      margin: -22% 0 0;
    }
    .case-layered .main figcaption {
      max-width: 46%;
    }
    .case-bleed .detail {
      display: none;
    }
    .case-band .info {
      display: block;
    }
    .case-band .info .tlink {
      margin-top: 24px;
    }
    .sum {
      font-size: 1.125rem;
    }
  }
</style>
