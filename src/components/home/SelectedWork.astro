---
import type { HomeCopy } from '../../content/home.en';
import ProjectMedia from '../ProjectMedia.astro';
import { narrowCrops } from '../projectCrops';
import { capabilityName } from '../../content/capabilities';
import type { Project } from '../../content/projects';
import { caseStudyPath, pathFor } from '../../i18n/routes';
import type { Locale } from '../../i18n/locales';

interface Props {
  copy: HomeCopy['work'];
  projects: readonly Project[];
  locale: Locale;
}

const { copy, projects, locale } = Astro.props;
const total = projects.length;
const pad = (n: number) => String(n).padStart(2, '0');
const facts = (p: Project) => p.capabilities.map((id) => capabilityName(id, locale)).join(', ');

// Composition follows the capture, not a template: a very wide capture spans the width under the title, the
// others alternate sides. Presentation only.
let side = 0;
const layoutOf = (p: Project) => {
  if (!p.image) return 'left';
  const ratio = p.image.src.width / p.image.src.height;
  if (ratio > 2) return 'wide';
  return side++ % 2 === 0 ? 'left' : 'right';
};
const focusOf = narrowCrops;
---

{/* Selected work. The Ink surface takes over behind the arc of a very large circle (the `.horizon` edge, base.css):
    the hero's arc has become a surface. Each project is a full-screen editorial composition. On tall desktop screens with motion
    allowed, each one sticks and the next slides over it in normal document flow: reading order, keyboard order and
    find-in-page follow the document. Elsewhere they simply stack. Captures are flat and keep their proportions. */}
<section class="work s-ink horizon" id="work" aria-labelledby="work-h" data-scene>
  <div class="work-head">
    <h2 id="work-h" data-reveal="lines"><span class="ln"><span>{copy.heading}</span></span></h2>
    <a class="tlink all" href={pathFor('work', locale)}>{copy.all}</a>
  </div>
  <div class="stack">
    {
      projects.map((p, i) => {
        const layout = layoutOf(p);
        const href = p.caseStudy ? caseStudyPath(p.slug, locale) : undefined;
        return (
          <article
            class={`case case-${layout}`}
            id={`case-${p.slug}`}
            aria-labelledby={`case-${p.slug}-h`}
            data-scene="case"
          >
            <div class="case-top rule" data-reveal="fade">
              <span class="num">
                {pad(i + 1)} / {pad(total)}
              </span>
              <span class="meta-label">{p.category}</span>
            </div>
            <div class="case-grid">
              {p.image && (
                <a class="media" href={href} tabindex="-1" aria-hidden="true">
                  <ProjectMedia
                    image={p.image}
                    alt=""
                    sizes={layout === 'wide' ? '(min-width: 1024px) 92vw, 100vw' : '(min-width: 1024px) 60vw, 100vw'}
                    crop={p.slug in focusOf}
                    focus={focusOf[p.slug]}
                    reveal
                  />
                </a>
              )}
              <div class="case-txt" data-reveal="fade" style="--delay:120ms">
                <h3 id={`case-${p.slug}-h`}>{p.name}</h3>
                <div class="detail">
                  <p class="sum">{p.summary}</p>
                  <dl class="facts">
                    <div class="rule">
                      <dt>{copy.factsLabel}</dt>
                      <dd>{facts(p)}</dd>
                    </div>
                  </dl>
                  {href && (
                    <a class="tlink" href={href} aria-label={`${copy.caseLink}: ${p.name}`}>
                      {copy.caseLink} →
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  /* ---------- Section head ---------- */
  .work {
    position: relative;
    padding-bottom: clamp(72px, 9vw, 136px);
  }
  .work-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: end;
    padding: clamp(24px, 3vw, 48px) var(--space-margin) clamp(56px, 7vw, 104px);
  }
  h2 {
    grid-column: 1 / span 8;
    font-size: var(--text-display-xl);
    line-height: 0.98;
    letter-spacing: -0.032em;
  }
  .all {
    grid-column: 11 / span 2;
    justify-self: end;
    padding-bottom: 0.5em;
    white-space: nowrap;
  }

  /* ---------- One project ---------- */
  .case {
    position: relative;
    background: var(--color-ink);
    padding: 0 var(--space-margin) clamp(56px, 6vw, 96px);
    display: flex;
    flex-direction: column;
  }
  .case-top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0 0;
  }
  .case-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    row-gap: clamp(28px, 3vw, 44px);
    align-content: end;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .media {
    display: block;
    align-self: end;
  }
  .media :global(.pm img) {
    transition: transform 900ms var(--ease-reveal);
  }
  @media (hover: hover) {
    .media:hover :global(.pm img) {
      transform: scale(1.015);
    }
  }
  h3 {
    font-size: var(--text-display-m);
    line-height: 1.02;
    letter-spacing: -0.024em;
  }
  .sum {
    font-size: var(--text-lead);
    line-height: 1.42;
    max-width: 34ch;
  }
  .facts {
    margin-top: 28px;
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-small);
  }
  .facts dt {
    color: var(--ter);
    font-weight: var(--weight-ui);
  }
  .facts dd {
    text-align: right;
  }
  .detail .tlink {
    display: inline-block;
    margin-top: 28px;
  }

  @media (min-width: 1024px) {
    /* Wide capture: the name and its detail share a line above, the capture spans the width below. */
    .case-wide .case-txt {
      grid-column: 1 / -1;
      grid-row: 1;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-gap);
      align-items: start;
    }
    .case-wide h3 {
      grid-column: 1 / span 7;
      font-size: var(--text-display-l);
    }
    .case-wide .detail {
      grid-column: 9 / span 4;
    }
    .case-wide .media {
      grid-column: 1 / -1;
      grid-row: 2;
      --maxh: calc(100svh - 400px);
    }

    /* Capture on the left, text low on the right. */
    .case-left .media {
      grid-column: 1 / span 7;
      grid-row: 1;
      --maxh: calc(100svh - 230px);
    }
    .case-left .case-txt {
      grid-column: 9 / span 4;
      grid-row: 1;
      align-self: end;
    }

    /* Text low on the left, capture on the right. */
    .case-right .case-txt {
      grid-column: 1 / span 4;
      grid-row: 1;
      align-self: end;
    }
    .case-right .media {
      grid-column: 5 / span 8;
      grid-row: 1;
      justify-self: end;
      --maxh: calc(100svh - 230px);
    }
    .case-right .media :global(.pm) {
      margin-left: auto;
    }
    .case-left h3,
    .case-right h3 {
      margin-bottom: 22px;
    }
  }

  /* The handoff: on tall desktop screens, with motion allowed, each project holds the screen and the next one
     slides over it. Plain sticky positioning. */
  @media (min-width: 1024px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .case {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: clip;
      padding-top: 24px;
    }
    .case + .case {
      box-shadow: 0 -1px 0 var(--line);
    }
  }

  /* Scroll scene (html.sc). Depth inside a project: as it slides in, the capture travels further than the text, so
     the two separate like layers. Depth between projects: the one being covered settles back, a little smaller and
     darker, while the next slides over it; the last one settles back as Capabilities arrives. Individual
     `translate` and `scale` properties, so nothing competes with the reveal system's `transform`. */
  :global(.sc) .work {
    padding-bottom: 0;
    margin-bottom: 0;
  }
  /* Room for the horizon to sweep across empty Ink before the heading, so the edge never cuts through text. */
  :global(.sc) .work-head {
    padding-top: 30vh;
  }
  :global(.sc) .work-head h2 {
    translate: 0 calc((1 - var(--in, 1)) * 14vh);
  }
  :global(.sc) .case + .case {
    box-shadow: none;
  }
  :global(.sc) .case {
    transform-origin: 50% 0;
    scale: calc(1 - var(--cov, 0) * 0.07);
    translate: 0 calc(var(--cov, 0) * -3vh);
  }
  :global(.sc) .case::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    opacity: calc(var(--cov, 0) * 0.72);
    pointer-events: none;
  }
  :global(.sc) .case .media {
    translate: 0 calc((1 - var(--in, 1)) * 16vh);
  }
  :global(.sc) .case .case-txt {
    translate: 0 calc((1 - var(--in, 1)) * 6vh);
  }

  /* ---------- Tablet and phone: stacked, capture first at full width ---------- */
  @media (max-width: 1023px) {
    .work-head {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      padding-top: 88px;
    }
    h2 {
      grid-column: 1 / span 6;
    }
    .all {
      grid-column: 7 / span 2;
    }
    .case {
      padding: 0 0 72px;
    }
    .case-top {
      margin: 0 var(--space-margin);
      padding-bottom: 18px;
    }
    .case-grid {
      display: block;
      margin-top: 0;
    }
    .media :global(.pm) {
      width: 100%;
    }
    .case-txt {
      padding: 28px var(--space-margin) 0;
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: var(--space-gap);
    }
    h3 {
      grid-column: 1 / span 4;
    }
    .detail {
      grid-column: 5 / span 4;
    }
  }

  @media (max-width: 760px) {
    .work-head {
      display: block;
      padding-top: 80px;
      padding-bottom: 48px;
    }
    .all {
      display: inline-block;
      margin-top: 22px;
    }
    .case {
      padding-bottom: 64px;
    }
    .case-top {
      font-size: 0.875rem;
    }
    .case-top .meta-label {
      text-align: right;
    }
    .case-txt {
      display: block;
      padding-top: 24px;
    }
    .sum {
      margin-top: 14px;
    }
    .facts {
      margin-top: 22px;
    }
  }
</style>
