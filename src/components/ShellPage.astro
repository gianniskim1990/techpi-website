---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/locales';
import type { PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = getDictionary(locale);
const { title, heading } = t.pages[page];
---

{/* A labelled placeholder that tests routing. Not a page design and not page content. It is an unpublished route
    shell, so it stays noindex even when indexing is enabled for the rest of the site (EU Projects, until approved
    content exists: docs/production/launch-blockers.md). */}
<BaseLayout locale={locale} page={page} title={title} noindex>
  <h1>{heading}</h1>
  <p class="shell-note">{t.shell.note}</p>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2.5rem, 6.6vw, 6rem);
    line-height: 1;
    letter-spacing: -0.032em;
  }
  .shell-note {
    margin-top: 24px;
    color: var(--color-graphite);
    max-width: 52ch;
  }
</style>
