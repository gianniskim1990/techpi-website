---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../i18n';
import { homePathFor } from '../i18n/routes';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

{/* Static 404 foundation. Served by Cloudflare with a real 404 status. Not designed yet. */}
<BaseLayout locale={locale} title={t.notFound.title} kind="notfound">
  <h1>{t.notFound.heading}</h1>
  <p class="not-found-text">{t.notFound.text}</p>
  <p><a class="tlink" href={homePathFor(locale)}>{t.notFound.home}</a></p>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2.5rem, 6.6vw, 6rem);
    line-height: 1;
    letter-spacing: -0.032em;
  }
  .not-found-text {
    margin: 32px 0 28px;
    max-width: 40ch;
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--color-graphite);
  }
</style>
