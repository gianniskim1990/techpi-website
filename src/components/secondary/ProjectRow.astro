---
import { capabilityName } from '../../content/capabilities';
import type { Project } from '../../content/projects';
import type { Locale } from '../../i18n/locales';
import { caseStudyPath } from '../../i18n/routes';
import Crop from '../Crop.astro';
import { compositions } from '../workCompositions';

interface Props {
  project: Project;
  locale: Locale;
  capabilitiesLabel: string;
  linkLabel: string;
}

const { project, locale, capabilitiesLabel, linkLabel } = Astro.props;
const capabilities = project.capabilities.map((id) => capabilityName(id, locale)).join(', ');
// A row links to its case study only when that page exists. Index-only projects stay plain.
const href = project.caseStudy ? caseStudyPath(project.slug, locale) : undefined;
const thumb = compositions[project.slug]?.thumb;
---

{/* One line of the Work index, read across like a catalogue: the name, what it is, what was built, and for a
    project with a case study, a small 3:2 crop of the real capture at the end of the line. No placeholder picture
    for the others. The crop is decorative for assistive technology: the heading and the link carry the meaning. */}
<article class:list={['row', { linked: href }]} data-reveal="fade">
  <h2>
    {href ? <a class="name" href={href}>{project.name}</a> : project.name}
  </h2>
  <p class="cat">{project.category}</p>
  <div class="body">
    <p class="sum">{project.summary}</p>
    <p class="caps"><span>{capabilitiesLabel}:</span> {capabilities}</p>
    {href && <p class="more" aria-hidden="true">{linkLabel}</p>}
  </div>
  {
    project.image && (
      <div class="thumb" aria-hidden="true">
        <Crop image={project.image} alt="" crop={thumb} vw={[24, 100]} />
      </div>
    )
  }
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: start;
    padding: clamp(22px, 2.2vw, 30px) 0 clamp(26px, 2.6vw, 34px);
    border-top: 1px solid var(--color-rule);
  }
  h2 {
    grid-column: 1 / span 4;
    font-size: clamp(1.625rem, 2.6vw, 2.375rem);
    line-height: 1.05;
    letter-spacing: -0.022em;
  }
  .name {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-state);
  }
  /* The whole line is the target of a case study link. */
  .name::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .name:focus-visible {
    outline-offset: 6px;
  }
  /* Hover on a line with a case study: the same Ink band as the homepage index wipes in from the left, edge to
     edge; the text turns to Paper and the crop leans in. */
  .row {
    isolation: isolate;
  }
  .row::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -1px;
    bottom: 0;
    left: calc(-1 * var(--space-margin));
    right: calc(-1 * var(--space-margin));
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 620ms var(--ease-reveal);
  }
  h2,
  .cat,
  .sum,
  .caps,
  .more {
    transition:
      color 300ms var(--ease-state),
      translate 620ms var(--ease-reveal);
  }
  .thumb :global(img) {
    transition: scale 900ms var(--ease-reveal);
  }
  @media (hover: hover) {
    .linked:hover::before {
      transform: scaleX(1);
      transform-origin: 0 50%;
    }
    .linked:hover h2 {
      color: var(--color-paper);
      translate: 14px 0;
    }
    .linked:hover .sum {
      color: var(--color-paper);
    }
    .linked:hover .cat,
    .linked:hover .caps {
      color: var(--color-fog);
    }
    .linked:hover .more {
      color: var(--color-cyan);
    }
    .linked:hover .thumb :global(img) {
      scale: 1.06;
    }
  }
  .cat {
    grid-column: 5 / span 2;
    padding-top: 0.5em;
    font-size: var(--text-small);
    color: var(--ter);
  }
  .body {
    grid-column: 7 / span 3;
    padding-top: 0.3em;
  }
  .sum {
    color: var(--sec-c);
  }
  .caps {
    margin-top: 10px;
    font-size: var(--text-small);
    color: var(--ter);
  }
  .more {
    margin-top: 14px;
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    text-decoration: underline;
    text-underline-offset: 0.28em;
    transition: color var(--duration-fast) var(--ease-state);
  }
  .thumb {
    grid-column: 10 / span 3;
    padding-top: 0.3em;
    background: transparent;
  }

  @media (max-width: 1023px) {
    .row {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    h2 {
      grid-column: 1 / span 5;
    }
    .cat {
      grid-column: 6 / span 3;
      padding-top: 0.6em;
    }
    .body {
      grid-column: 1 / span 5;
      margin-top: 14px;
    }
    .thumb {
      grid-column: 6 / span 3;
      margin-top: 14px;
    }
  }

  @media (max-width: 760px) {
    .row {
      display: flex;
      flex-direction: column;
    }
    .cat {
      order: -1;
      padding: 0 0 6px;
    }
    .thumb {
      order: 2;
      margin-top: 18px;
      width: 100%;
    }
    .body {
      order: 3;
      margin-top: 16px;
    }
  }
</style>
