---
import { Image } from 'astro:assets';
import { capabilityName } from '../../content/capabilities';
import type { Project } from '../../content/projects';
import { caseStudyPath } from '../../i18n/routes';
import FactRows from './FactRows.astro';

interface Props {
  project: Project;
  /** 1, 2 or 3: picks one of the three neutral tints for the media field. */
  tone: number;
  capabilitiesLabel: string;
  linkLabel: string;
}

const { project, tone, capabilitiesLabel, linkLabel } = Astro.props;
const capabilities = project.capabilities.map(capabilityName).join(', ');
// A row links to its case study only when that page exists. Index-only projects stay plain.
const href = project.caseStudy ? caseStudyPath(project.slug) : undefined;
const placeholderWord = project.name.split(' ')[0];
---

{/* One large editorial row on Ink. Real project imagery where it exists, flat on a neutral field and never
    cropped. Without an image, a neutral placeholder. The media is decorative for assistive technology: the row's
    heading and link carry the meaning. */}
<article class="row">
  {
    href ? (
      <a class={`media tone-${tone}`} href={href} tabindex="-1" aria-hidden="true">
        {project.image && (
          <Image
            src={project.image.src}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            format="webp"
            quality={82}
          />
        )}
      </a>
    ) : (
      <div class={`media tone-${tone}`} aria-hidden="true">
        {project.image ? (
          <Image
            src={project.image.src}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            format="webp"
            quality={82}
          />
        ) : (
          <span class="word">{placeholderWord}</span>
        )}
      </div>
    )
  }
  <div class="text">
    <p class="cat">{project.category}</p>
    <h2>{project.name}</h2>
    <p class="sum">{project.summary}</p>
    <FactRows rows={[{ label: capabilitiesLabel, value: capabilities }]} />
    {
      href && (
        <a class="tlink" href={href} aria-label={`${linkLabel}: ${project.name}`}>
          {linkLabel} →
        </a>
      )
    }
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    padding: 72px 0;
    border-top: 1px solid var(--line);
  }
  .row:first-child {
    border-top: 0;
    padding-top: 32px;
  }
  .media {
    grid-column: 1 / span 8;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4%;
  }
  .media :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .tone-1 {
    background: #131b36;
  }
  .tone-2 {
    background: #1e1f23;
  }
  .tone-3 {
    background: #14232b;
  }
  .word {
    position: absolute;
    left: -0.04em;
    bottom: -0.2em;
    font-size: clamp(6rem, 18vw, 17rem);
    line-height: 1;
    font-weight: var(--weight-name);
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: rgba(240, 238, 233, 0.055);
  }
  .text {
    grid-column: 9 / span 4;
    padding-left: clamp(0px, 2vw, 32px);
    padding-bottom: 10vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .cat {
    font-size: 0.8125rem;
    font-weight: var(--weight-ui);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ter);
  }
  h2 {
    margin-top: 14px;
    font-size: var(--text-display-m);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .sum {
    margin-top: 18px;
    font-size: var(--text-lead);
    line-height: 1.42;
  }
  .text :global(.facts) {
    margin-top: 26px;
  }
  .text .tlink {
    margin-top: 28px;
    align-self: flex-start;
  }

  @media (max-width: 1023px) {
    .row {
      display: block;
      padding: 0 0 64px;
      border-top: 0;
    }
    .row:first-child {
      padding-top: 0;
    }
    .media {
      aspect-ratio: 16 / 10;
    }
    .text {
      padding: 22px var(--space-margin) 0;
    }
  }

  @media (max-width: 760px) {
    .media {
      aspect-ratio: 4 / 3;
      padding: 5%;
    }
  }
</style>
