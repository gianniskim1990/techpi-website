---
import { capabilityName } from '../../content/capabilities';
import type { Project } from '../../content/projects';
import type { Locale } from '../../i18n/locales';
import { caseStudyPath } from '../../i18n/routes';
import ProjectMedia from '../ProjectMedia.astro';
import { narrowCrops } from '../projectCrops';
import FactRows from './FactRows.astro';

interface Props {
  project: Project;
  locale: Locale;
  /** The position in the list, from 1. */
  index: number;
  capabilitiesLabel: string;
  linkLabel: string;
}

const { project, locale, index, capabilitiesLabel, linkLabel } = Astro.props;
const capabilities = project.capabilities.map((id) => capabilityName(id, locale)).join(', ');
// A row links to its case study only when that page exists. Index-only projects stay plain.
const href = project.caseStudy ? caseStudyPath(project.slug, locale) : undefined;
const num = String(index).padStart(2, '0');
const focusOf = narrowCrops;
---

{/* Two forms in one family. A project with real imagery is a large editorial row: the capture flat on Ink, the
    text beside it. A project without imagery is an index line, typographic only: no placeholder picture. The
    media is decorative for assistive technology: the heading and the link carry the meaning. */}
{
  project.image ? (
    <article class="row feature rule" data-reveal="fade">
      <p class="top">
        <span class="num">{num}</span>
        <span class="meta-label">{project.category}</span>
      </p>
      <a class="media" href={href} tabindex="-1" aria-hidden="true">
        <ProjectMedia
          image={project.image}
          alt=""
          sizes="(min-width: 1024px) 62vw, 100vw"
          crop={project.slug in focusOf}
          focus={focusOf[project.slug]}
          reveal
        />
      </a>
      <div class="text">
        <h2>{project.name}</h2>
        <p class="sum">{project.summary}</p>
        <FactRows rows={[{ label: capabilitiesLabel, value: capabilities }]} />
        {href && (
          <a class="tlink" href={href} aria-label={`${linkLabel}: ${project.name}`}>
            {linkLabel} →
          </a>
        )}
      </div>
    </article>
  ) : (
    <article class="row index rule" data-reveal="fade">
      <span class="num">{num}</span>
      <h2>{project.name}</h2>
      <p class="meta-label">{project.category}</p>
      <p class="sum">{project.summary}</p>
      <p class="caps">
        <span class="caps-label">{capabilitiesLabel}</span> {capabilities}
      </p>
    </article>
  )
}

<style>
  /* ---------- Feature row ---------- */
  .feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    padding: 18px 0 clamp(72px, 8vw, 128px);
  }
  .top {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(28px, 3vw, 48px);
  }
  .media {
    grid-column: 1 / span 8;
    display: block;
    align-self: end;
  }
  .media :global(.pm img) {
    transition: transform 900ms var(--ease-reveal);
  }
  @media (hover: hover) {
    .media:hover :global(.pm img) {
      transform: scale(1.015);
    }
  }
  .text {
    grid-column: 9 / span 4;
    align-self: end;
  }
  h2 {
    font-size: var(--text-display-m);
    line-height: 1.04;
    letter-spacing: -0.024em;
  }
  .sum {
    margin-top: 18px;
    font-size: var(--text-lead);
    line-height: 1.42;
  }
  .text :global(.facts) {
    margin-top: 26px;
  }
  .text .tlink {
    display: inline-block;
    margin-top: 28px;
  }

  /* ---------- Index line ---------- */
  .index {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    row-gap: 8px;
    padding: 24px 0 32px;
    align-items: baseline;
  }
  .index:last-child {
    border-bottom: 1px solid var(--line);
  }
  .index .num {
    grid-column: 1 / span 1;
  }
  .index h2 {
    grid-column: 2 / span 4;
    font-size: var(--text-heading);
    line-height: 1.15;
    letter-spacing: -0.012em;
  }
  .index .meta-label {
    grid-column: 6 / span 3;
  }
  .index .sum {
    grid-column: 9 / span 4;
    margin-top: 0;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--sec-c);
  }
  .index .caps {
    grid-column: 9 / span 4;
    font-size: var(--text-small);
    color: var(--sec-c);
  }
  .caps-label {
    margin-right: 8px;
    font-weight: var(--weight-ui);
    color: var(--ter);
  }

  @media (max-width: 1023px) {
    .feature {
      display: block;
      padding-bottom: 72px;
    }
    .top {
      margin-bottom: 20px;
    }
    .media {
      margin: 0 calc(var(--space-margin) * -1);
    }
    .media :global(.pm) {
      width: 100%;
    }
    .text {
      margin-top: 28px;
      max-width: 560px;
    }
    .index {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .index h2 {
      grid-column: 2 / span 3;
    }
    .index .meta-label {
      grid-column: 5 / span 4;
    }
    .index .sum,
    .index .caps {
      grid-column: 5 / span 4;
    }
  }

  @media (max-width: 760px) {
    .index {
      display: block;
      padding: 20px 0 28px;
    }
    .index .num {
      display: block;
      margin-bottom: 10px;
    }
    .index .meta-label {
      margin-top: 8px;
    }
    .index .sum {
      margin-top: 12px;
    }
    .index .caps {
      margin-top: 6px;
    }
  }
</style>
