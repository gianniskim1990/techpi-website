---
interface Row {
  label: string;
  value?: string | undefined;
  /**
   * Makes the value a link. The visible text should be the address or number itself.
   * An http(s) address is an external site: it gets the ↗ arrow and `rel="noopener"`.
   * A `mailto:` or `tel:` address is an action on this device, not another site: plain link, no arrow.
   */
  href?: string;
  /** Added to the link's accessible name, in the page language, for example "opens the live website". External links only. */
  hrefLabel?: string;
}

interface Props {
  rows: readonly Row[];
  /**
   * rows   label left, value right, a hairline between rows (default)
   * strip  the facts side by side as columns, label above value (a case-study head)
   * large  rows with the value set large, for facts that are the point of the page (Contact)
   */
  variant?: 'rows' | 'strip' | 'large';
}

const { variant = 'rows' } = Astro.props;
// A row with no confirmed value is never shown: no dash, no "to confirm".
const rows = Astro.props.rows.filter((r): r is Row & { value: string } => Boolean(r.value));
const isAction = (href: string) => href.startsWith('mailto:') || href.startsWith('tel:');
---

{
  rows.length > 0 && (
    <dl class:list={['facts', `facts-${variant}`]} style={`--n:${rows.length}`}>
      {rows.map((r) => (
        <div>
          <dt>{r.label}</dt>
          <dd>
            {r.href && isAction(r.href) ? (
              <a class="tlink action" href={r.href}>
                {r.value}
              </a>
            ) : r.href ? (
              <a
                class="tlink"
                href={r.href}
                rel="noopener"
                aria-label={r.hrefLabel ? `${r.value} (${r.hrefLabel})` : undefined}
              >
                {r.value} <span aria-hidden="true">↗</span>
              </a>
            ) : (
              r.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .facts div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 16px;
    padding: 13px 0;
    border-top: 1px solid var(--line);
    font-size: var(--text-small);
  }
  .facts div:last-child {
    border-bottom: 1px solid var(--line);
  }
  dt {
    color: var(--ter);
    font-weight: var(--weight-ui);
  }

  /* Strip: columns, label above value. */
  .facts-strip {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  .facts-strip div,
  .facts-strip div:last-child {
    display: block;
    padding: 16px 0 0;
    border-bottom: 0;
  }
  .facts-strip dd {
    margin-top: 6px;
    font-size: 1rem;
  }

  /* Large: the value is the point. */
  .facts-large div {
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    align-items: baseline;
    padding: clamp(18px, 2vw, 28px) 0;
  }
  .facts-large dd {
    font-size: var(--text-display-m);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: var(--weight-display);
    overflow-wrap: anywhere;
  }
  .facts-large .tlink {
    font-weight: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
  .facts-large .tlink:hover {
    text-underline-offset: 0.2em;
  }

  /* Email and phone are tapped on a phone. The visible link stays text-sized, so the focus ring stays tight,
     and an invisible area grows the touch target to about 46px high. It stays inside the row, so the targets of
     neighbouring rows never overlap. */
  .action {
    position: relative;
  }
  .action::after {
    content: '';
    position: absolute;
    inset: -14px -6px;
  }
  .facts-large .action::after {
    inset: -8px -6px;
  }

  @media (max-width: 760px) {
    .facts div,
    .facts-large div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .facts-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 20px;
    }
    .facts-strip div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .facts-large dd {
      font-size: clamp(1.5rem, 7vw, 2rem);
    }
  }
</style>
