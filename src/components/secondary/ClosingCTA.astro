---
import Arrowed from '../Arrowed.astro';
import Unbroken from '../Unbroken.astro';
interface Props {
  heading: string;
  /** An optional supporting sentence under the question. */
  text?: string;
  cta: string;
  href: string;
}

const { heading, text, cta, href } = Astro.props;
---

{/* The quiet closing line of a secondary page: the homepage question on Paper. No circle and no symbol here: the
    identity resolves once, on the homepage. The Ink footer follows. */}
<section class="closer s-paper rule" aria-label={heading} data-reveal="fade">
  <div class="q">
    <p class="question"><Unbroken text={heading} /></p>
    {text && <p class="support">{text}</p>}
  </div>
  <p class="act"><a class="btn" href={href}><Arrowed text={cta} /></a></p>
</section>

<style>
  .closer {
    margin: var(--space-section) var(--space-margin) 0;
    padding: clamp(64px, 8vw, 120px) 0 clamp(72px, 9vw, 136px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
    align-items: end;
  }
  .q {
    grid-column: 1 / span 8;
  }
  .support {
    margin-top: 24px;
    max-width: 52ch;
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--sec-c);
  }
  .question {
    font-size: var(--text-display-l);
    font-weight: var(--weight-display);
    line-height: 1.02;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }
  .question:lang(el) {
    line-height: 1.08;
  }
  .act {
    grid-column: 10 / span 3;
    justify-self: end;
    padding-bottom: 0.4em;
  }

  @media (max-width: 1023px) {
    .q {
      grid-column: 1 / -1;
    }
    .act {
      grid-column: 1 / -1;
      justify-self: start;
      margin-top: 36px;
    }
  }

  @media (max-width: 760px) {
    .closer {
      display: block;
    }
    .act .btn {
      display: flex;
    }
  }
</style>
