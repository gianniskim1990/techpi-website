---
interface Props {
  heading: string;
  cta: string;
  href: string;
}

const { heading, cta, href } = Astro.props;
---

{/* The quiet closing line. The homepage question on Paper: no Blue surface, no circle. The Ink footer follows. */}
<section class="closer s-paper" aria-label={heading}>
  <p class="question">{heading}</p>
  <a class="btn" href={href}>{cta}</a>
</section>

<style>
  .closer {
    margin: var(--space-section) var(--space-margin) 0;
    padding: 104px 0;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
  }
  .question {
    font-size: var(--text-display-m);
    font-weight: var(--weight-display);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  @media (max-width: 760px) {
    .closer {
      display: block;
      padding: 72px 0;
    }
    .btn {
      display: flex;
      margin-top: 28px;
    }
  }
</style>
