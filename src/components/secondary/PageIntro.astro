---
import Unbroken from '../Unbroken.astro';
interface Props {
  heading: string;
  lead?: string;
  /** Extra room under the page head, for page-specific geometry that must finish clear of the text (About). */
  roomBelow?: boolean;
  /** 'word': a one-word heading set very large, with the lead beside it on its baseline (Work). */
  variant?: 'default' | 'word';
}

const { heading, lead, roomBelow = false, variant = 'default' } = Astro.props;
---

{/* The page head of every secondary page, in the same family as the homepage hero but calmer: one large h1, then
    a hairline and the lead offset to the right, the way the hero sets its supporting line. No label, no button,
    no image. The default slot is for page-specific geometry only (the About arc). */}
<section class:list={['intro', 's-paper', `v-${variant}`, { room: roomBelow }]}>
  <slot />
  <h1 data-reveal="mask"><Unbroken text={heading} /></h1>
  {
    lead && (
      <div class="lead-row" data-reveal="fade" style="--delay:160ms">
        <p class="lead">{lead}</p>
        <div class="after"><slot name="after" /></div>
      </div>
    )
  }
</section>

<style>
  .intro {
    position: relative;
    overflow: clip;
    padding: clamp(152px, 15vw, 216px) var(--space-margin) 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-gap);
  }
  h1 {
    position: relative;
    grid-column: 1 / span 10;
    font-size: clamp(2.5rem, 6.6vw, 6rem);
    line-height: 1;
    letter-spacing: -0.032em;
  }
  h1:lang(el) {
    font-size: calc(clamp(2.5rem, 6.6vw, 6rem) * var(--greek-display));
    line-height: 1.06;
  }
  .lead-row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: clamp(40px, 5vw, 72px);
  }

  /* A one-word page name, set as large as the window allows and sitting on the bottom of the head, with the lead
     beside it. */
  .v-word {
    align-items: end;
  }
  .v-word h1 {
    grid-column: 1 / span 7;
    grid-row: 1;
    font-size: clamp(4.5rem, 19vw, 17rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    margin-left: -0.04em;
    /* Room for descenders (the ρ and γ of Έργα): the head clips its overflow. */
    padding-bottom: 0.2em;
  }
  .v-word h1:lang(el) {
    font-size: calc(clamp(4.5rem, 19vw, 17rem) * 0.82);
    line-height: 0.86;
  }
  .v-word .lead-row {
    grid-row: 1;
    grid-column: 8 / -1;
    margin-top: 0;
    padding-bottom: 0.4em;
    display: block;
  }
  .v-word .lead {
    max-width: 30ch;
  }
  .lead {
    grid-column: 7 / span 5;
    font-size: var(--text-lead);
    line-height: 1.42;
    color: var(--sec-c);
    /* Avoids a single word alone on the last line. Ignored where unsupported. */
    text-wrap: pretty;
  }

  .after {
    grid-column: 7 / span 5;
  }
  .after:empty {
    display: none;
  }

  .room {
    padding-bottom: 72px;
  }

  @media (max-width: 1023px) {
    .lead,
    .after {
      grid-column: 5 / span 8;
    }
    .v-word h1 {
      grid-column: 1 / -1;
    }
    .v-word .lead-row {
      grid-row: 2;
      grid-column: 6 / -1;
      margin-top: 32px;
    }
  }

  @media (max-width: 760px) {
    .room {
      padding-bottom: 0;
    }
    .intro {
      display: block;
      padding-top: 128px;
    }
    .lead-row {
      display: block;
      margin-top: 32px;
    }
    .v-word .lead-row {
      margin-top: 28px;
    }
  }
</style>
