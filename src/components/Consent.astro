---
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/locales';
import { pathFor } from '../i18n/routes';
import { analyticsFacts } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

{/* The analytics consent banner (src/scripts/consent.ts). Hidden until the script finds no stored choice, so without
    scripting nothing shows and nothing loads. Not a modal: the page stays usable, and focus is never trapped. Accept and
    Reject are the same kind of button, side by side, as the Hellenic DPA's guidance on cookies asks. */}
<section
  class="consent s-ink"
  aria-label={t.consent.label}
  data-consent
  data-measurement-id={analyticsFacts.measurementId}
  hidden
>
  <p>
    {t.consent.text}
    {' '}<a href={pathFor('cookies', locale)}>{t.pages.cookies.heading}</a>
  </p>
  <div class="actions">
    <button type="button" class="btn" data-consent-accept>{t.consent.accept}</button>
    <button type="button" class="btn" data-consent-reject>{t.consent.reject}</button>
  </div>
</section>

<script>
  import '../scripts/consent';
</script>

<style>
  .consent {
    position: fixed;
    /* Above the header (50), below the homepage intro (60, 70), which ends on its own within seconds. */
    z-index: 55;
    left: var(--space-margin);
    bottom: 24px;
    max-width: min(720px, calc(100vw - 2 * var(--space-margin)));
    padding: 32px 36px 34px;
    border: 1px solid var(--line);
    font-size: 1.0625rem;
    line-height: 1.55;
    box-shadow: 0 24px 64px rgba(8, 14, 30, 0.36);
  }
  .consent[hidden] {
    display: none;
  }
  p {
    color: var(--color-paper);
  }
  a {
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  /* Accept and Reject: the same size, style and weight, so neither is the easier choice. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }
  .btn {
    min-width: 180px;
    min-height: 58px;
    padding: 0 36px;
    font: inherit;
    font-size: 1.0625rem;
    font-weight: var(--weight-ui);
    border: 0;
    cursor: pointer;
  }
  /* Phones: a full-width sheet at the bottom of the window, with the two buttons sharing the width. */
  @media (max-width: 600px) {
    .consent {
      left: 0;
      right: 0;
      bottom: 0;
      max-width: none;
      padding: 24px var(--space-margin) calc(24px + env(safe-area-inset-bottom));
      border-width: 1px 0 0;
    }
    .actions .btn {
      flex: 1 1 0;
      min-width: 0;
      padding: 0 16px;
    }
  }
</style>
