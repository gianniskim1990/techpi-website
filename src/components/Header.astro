---
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/locales';
import { homePathFor, pathFor, type PageKey } from '../i18n/routes';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  locale: Locale;
  page?: PageKey;
}

const { locale, page } = Astro.props;
const t = getDictionary(locale);

// The approved navigation, in order. Nothing is added.
const items = ['work', 'capabilities', 'euProjects', 'about', 'contact'] as const;
const target: Record<(typeof items)[number], PageKey> = {
  work: 'work',
  capabilities: 'capabilities',
  euProjects: 'euProjects',
  about: 'about',
  contact: 'contact',
};
---

{/* Typographic name only. No symbol until the vector identity master exists. The header sits over the top of the
     page and scrolls away with it (no sticky or pinned behaviour yet). Up to 900px wide the links move to the footer,
     reached by "Menu": plain anchors, no script. */}
<header class="site-header">
  <a class="site-name" href={homePathFor(locale)} aria-label={`TechPi, ${t.pages.home.heading}`}>{t.site.name}</a>
  <nav class="site-nav" aria-label={t.nav.label}>
    <ul>
      {
        items.map((key) => (
          <li>
            <a href={pathFor(target[key], locale)} aria-current={page === target[key] ? 'page' : undefined}>
              {t.nav[key]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="util">
    <LanguageSwitch locale={locale} page={page} />
    <a class="menu" href="#footer">{t.nav.menu}</a>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 44px;
    padding: 20px var(--space-margin);
    font-size: var(--text-small);
  }
  .site-name {
    font-size: 1rem;
    font-weight: var(--weight-name);
    letter-spacing: 0.09em;
    text-decoration: none;
    padding: 12px 0;
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: 34px;
    font-weight: var(--weight-ui);
  }
  .site-nav a {
    display: inline-block;
    padding: 12px 0;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .util {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .menu {
    display: none;
    padding: 12px 0;
    font-weight: var(--weight-ui);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .site-header {
      padding: 10px var(--space-margin);
      gap: 16px;
    }
    .site-nav {
      display: none;
    }
    .util {
      margin-left: auto;
      gap: 18px;
    }
    .menu {
      display: inline-block;
    }
  }
</style>
