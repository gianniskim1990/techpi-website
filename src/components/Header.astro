---
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/locales';
import { homePathFor, pathFor, type PageKey } from '../i18n/routes';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  locale: Locale;
  page?: PageKey;
}

const { locale, page } = Astro.props;
const t = getDictionary(locale);

// The approved navigation, in order. Nothing is added.
const items = ['work', 'capabilities', 'euProjects', 'about', 'contact'] as const;
const target: Record<(typeof items)[number], PageKey> = {
  work: 'work',
  capabilities: 'capabilities',
  euProjects: 'euProjects',
  about: 'about',
  contact: 'contact',
};
---

{/* Typographic name only. No symbol until the vector identity master exists. The header sits over the top of the
     page and scrolls away with it (no sticky or pinned behaviour yet).
     Up to 900px wide the links move into a full-screen native <dialog> opened by the Menu button. Without
     JavaScript the button never appears and the Menu link to the footer navigation stays, so the links are
     always reachable. */}
<script is:inline>
  document.documentElement.classList.add('js');
</script>
<header class="site-header">
  <a class="site-name" href={homePathFor(locale)} aria-label={`TechPi, ${t.pages.home.heading}`}>{t.site.name}</a>
  <nav class="site-nav" aria-label={t.nav.label}>
    <ul>
      {
        items.map((key) => (
          <li>
            <a href={pathFor(target[key], locale)} aria-current={page === target[key] ? 'page' : undefined}>
              {t.nav[key]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="util">
    <LanguageSwitch locale={locale} page={page} />
    <a class="menu menu-link" href="#footer">{t.nav.menu}</a>
    <button class="menu menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      {t.nav.menu}
    </button>
  </div>
</header>

<dialog class="menu-dialog s-paper" id="site-menu" aria-label={t.nav.menu}>
  <div class="menu-top">
    <a class="site-name" href={homePathFor(locale)} aria-label={`TechPi, ${t.pages.home.heading}`}>{t.site.name}</a>
    <button class="menu menu-close" type="button" data-menu-close>{t.nav.close}</button>
  </div>
  <nav aria-label={t.nav.label}>
    <ul class="menu-items">
      {
        items.map((key) => (
          <li>
            <a href={pathFor(target[key], locale)} aria-current={page === target[key] ? 'page' : undefined}>
              {t.nav[key]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu-lang"><LanguageSwitch locale={locale} page={page} /></div>
</dialog>

<script>
  // Opens and closes the menu. showModal() makes the rest of the page inert and traps focus, Escape closes it,
  // and focus returns to the opener on close, all natively.
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && opener) {
    opener.addEventListener('click', () => {
      dialog.showModal();
      opener.setAttribute('aria-expanded', 'true');
    });
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener.setAttribute('aria-expanded', 'false'));
    // Following a link to this same page, or growing the window to desktop width, must not leave the menu open.
    dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
    window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches) dialog.close();
    });
  }
</script>

<style>
  .site-header {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 44px;
    padding: 20px var(--space-margin);
    font-size: var(--text-small);
  }
  .site-name {
    font-size: 1rem;
    font-weight: var(--weight-name);
    letter-spacing: 0.09em;
    text-decoration: none;
    padding: 12px 0;
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: 34px;
    font-weight: var(--weight-ui);
  }
  .site-nav a {
    display: inline-block;
    padding: 12px 0;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .util {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .menu {
    display: none;
    padding: 12px 0;
    font: inherit;
    font-weight: var(--weight-ui);
    text-decoration: none;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .menu-button {
    display: none;
  }

  @media (max-width: 900px) {
    .site-header {
      padding: 10px var(--space-margin);
      gap: 16px;
    }
    .site-nav {
      display: none;
    }
    .util {
      margin-left: auto;
      gap: 18px;
    }
    .menu-link {
      display: inline-block;
    }
    /* With JavaScript the button replaces the link. */
    :global(.js) .menu-link {
      display: none;
    }
    :global(.js) .menu-button {
      display: inline-block;
    }
  }

  /* The full-screen menu. Paper surface, no animation. */
  .menu-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 10px var(--space-margin) 40px;
    border: 0;
    overflow-y: auto;
  }
  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-close {
    display: inline-block;
  }
  .menu-items {
    margin-top: 56px;
  }
  .menu-items li {
    border-top: 1px solid var(--line);
  }
  .menu-items li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .menu-items a {
    display: block;
    padding: 18px 0;
    font-size: var(--text-display-m);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .menu-items a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 8px;
  }
  .menu-lang {
    margin-top: 32px;
    /* Optically aligns the first language link with the left text edge. */
    margin-left: -6px;
  }
</style>
