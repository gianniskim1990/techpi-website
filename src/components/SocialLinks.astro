---
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/locales';
import { socialProfiles } from '../content/site';

interface Props {
  locale: Locale;
  /** Icon size in pixels. */
  size?: number;
}

const { locale, size = 22 } = Astro.props;
const t = getDictionary(locale).social;

/** The network of each confirmed profile (site.ts), by its host. */
const NETWORKS = [
  { host: 'facebook.com', name: 'Facebook' },
  { host: 'instagram.com', name: 'Instagram' },
  { host: 'linkedin.com', name: 'LinkedIn' },
  { host: 'tiktok.com', name: 'TikTok' },
] as const;
const links = socialProfiles.map((href) => {
  const network = NETWORKS.find((n) => new URL(href).hostname.endsWith(n.host));
  if (!network) throw new Error(`SocialLinks: no icon for ${href}`);
  return { href, name: network.name };
});
---

{/* TechPi's own profiles (site.ts, the same list as `sameAs` in the JSON-LD). Plain links with inline icons in the
    text colour: nothing is loaded from the networks, no widget, no cookie. rel="me" marks them as TechPi's own. */}
<ul class="social" aria-label={t.label}>
  {
    links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="me noopener noreferrer" aria-label={t.on.replace('{name}', l.name)} title={l.name}>
          <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
            {l.name === 'Facebook' && (
              <path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
            )}
            {l.name === 'Instagram' && (
              <>
                <rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5.25" fill="none" stroke="currentColor" stroke-width="2" />
                <circle cx="12" cy="12" r="4.25" fill="none" stroke="currentColor" stroke-width="2" />
                <circle cx="17.6" cy="6.4" r="1.25" fill="currentColor" />
              </>
            )}
            {l.name === 'LinkedIn' && (
              <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            )}
            {l.name === 'TikTok' && (
              <path fill="currentColor" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            )}
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-left: -10px;
  }
  /* A 44 px target around each icon (WCAG 2.5.5), the icon in the text colour, brightening on hover and focus. */
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: inherit;
    opacity: 0.78;
    transition: opacity var(--duration-fast) var(--ease-state);
  }
  .social a:hover,
  .social a:focus-visible {
    opacity: 1;
  }
  svg {
    display: block;
  }
  @media (forced-colors: active) {
    .social a {
      opacity: 1;
    }
  }
</style>
