{
  // LOCAL-ONLY template for testing against the real GitHub App (docs/admin/A1.md, section 6).
  // Copy to wrangler.local.jsonc (git-ignored), then run: npm run build && npx wrangler dev --config wrangler.local.jsonc
  // Never deploy with this file: it is meant for `wrangler dev` on 127.0.0.1 only.
  //
  // Secrets are NOT in this file. They go only in .dev.vars (git-ignored, next to this file), which Wrangler loads for
  // local development: GITHUB_APP_PRIVATE_KEY, GITHUB_OAUTH_CLIENT_SECRET and SESSION_SECRET.
  // Signing in locally needs http://127.0.0.1:8787/auth/callback among the GitHub App's callback URLs (an owner-only
  // GitHub App setting; docs/admin/M4-GO-LIVE.md, step E).
  "name": "techpi-admin-local",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // Counts password sign-in attempts (worker/password.js): one SQLite-backed Durable Object, free on the Workers Free
  // plan. Used only when ADMIN_PASSWORD_HASH is set; GitHub sign-in does not need it.
  "durable_objects": { "bindings": [{ "name": "LOGIN_LIMITER", "class_name": "LoginLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginLimiter"] }],
  "vars": {
    // Not secret, but set only locally until deployment is approved.
    "GITHUB_OAUTH_CLIENT_ID": "",
    "ADMIN_GITHUB_USER_ID": "",
    "GITHUB_APP_ID": "",
    "GITHUB_APP_INSTALLATION_ID": "",
    // Drafts are based on, and pull requests target, this branch. `main` is refused by the Worker.
    "CONTENT_MODE": "development",
    "CONTENT_BASE_BRANCH": "feat/techpi-admin-m4-production-readiness"
  }
}
