{
  // PRODUCTION TEMPLATE for the TechPi Admin. Not active and not deployed. Applied at go-live only, after the owner has
  // approved it, the consolidated release is merged into main, and the GitHub sign-in is configured
  // (docs/admin/M4-GO-LIVE.md, steps E to G). Copy these values into wrangler.jsonc, or deploy with
  // `npx wrangler deploy --config wrangler.production.example.jsonc` once the empty values are filled in.
  //
  // Never set GITHUB_API_BASE, GITHUB_OAUTH_BASE or ENABLE_TEST_CONTENT: the Worker refuses to serve anything if any of
  // them is present in production mode.
  "name": "techpi-admin",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false,
  // The proposed hostname. Adding this route as a Custom Domain makes Cloudflare create the DNS record for it on deploy,
  // so it is part of the separately approved deployment, not of this pull request.
  "routes": [{ "pattern": "admin.techpi.eu", "custom_domain": true }],
  // Counts password sign-in attempts (worker/password.js): one SQLite-backed Durable Object, free on the Workers Free
  // plan. Used only when ADMIN_PASSWORD_HASH is set; GitHub sign-in does not need it.
  "durable_objects": { "bindings": [{ "name": "LOGIN_LIMITER", "class_name": "LoginLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginLimiter"] }],
  "vars": {
    // The GitHub App's Client ID (GitHub, Settings, Developer settings, GitHub Apps, the app, General). Not secret.
    "GITHUB_OAUTH_CLIENT_ID": "",
    // The owner's numeric GitHub user ID: the only account that can sign in. Not the username or email.
    "ADMIN_GITHUB_USER_ID": "",
    "GITHUB_APP_ID": "",
    "GITHUB_APP_INSTALLATION_ID": "",
    "CONTENT_MODE": "production",
    "CONTENT_BASE_BRANCH": "main",
    "ADMIN_HOSTNAME": "admin.techpi.eu"
  }
  // Secrets, uploaded separately (never committed), each with --config wrangler.production.example.jsonc:
  //   npx wrangler secret put GITHUB_OAUTH_CLIENT_SECRET
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put GITHUB_APP_PRIVATE_KEY
  // Optional, enables email and password sign-in (made privately by scripts/set-admin-password.mjs, see its header):
  //   ADMIN_PASSWORD_HASH
}
